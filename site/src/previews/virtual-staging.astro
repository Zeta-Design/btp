---
// DEV-ONLY PREVIEW, injected at /portfolio/virtual-staging/ under `astro dev`
// only (astro.config.mjs), so it doesn't exist in production builds. Its
// photos live in their own folder and are only imported here, so they stay out
// of production too. To launch: move this file to
// src/pages/portfolio/virtual-staging.astro (fix the import paths, drop the
// injectRoute and the `preview` prop) and set LIVE.virtualStaging = true.
//
// Rooms with a before photo get a drag-to-compare slider. Pairs live in
// before-after/<name>/{before,after}.jpg, where <name> matches the staged
// photo's filename; both are pixel-aligned and cropped to the same frame, so
// only the staging changes under the divider. Staged photos without a before
// yet still show, in the usual grid below the sliders.
import type { ImageMetadata } from 'astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import PortfolioCategoryLayout from '../components/PortfolioCategoryLayout.astro';
import PortfolioGallery from '../components/PortfolioGallery.astro';

const staged = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/virtual-staging/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const befores = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/virtual-staging/before-after/*/before.{jpg,jpeg,png,webp}',
  { eager: true },
);
const afters = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/virtual-staging/before-after/*/after.{jpg,jpeg,png,webp}',
  { eager: true },
);

const folderOf = (path: string) => path.split('/').at(-2)!;
const roomOf = (name: string) => name.replace(/^\d+-/, '').replace(/-/g, ' ');
const afterByName = Object.fromEntries(Object.entries(afters).map(([k, m]) => [folderOf(k), m.default]));
const pairs = Object.entries(befores)
  .map(([k, m]) => ({ name: folderOf(k), before: m.default, after: afterByName[folderOf(k)] }))
  .filter((p) => p.after)
  .sort((a, b) => a.name.localeCompare(b.name));
const paired = new Set(pairs.map((p) => p.name));
const singles = Object.keys(staged)
  .sort()
  .map((key) => {
    const name = key.split('/').pop()!.replace(/\.\w+$/, '');
    return { name, meta: staged[key].default, alt: `Virtually staged ${roomOf(name)}` };
  })
  .filter((p) => !paired.has(p.name));
---
<PortfolioCategoryLayout categoryId="virtual-staging" photos={singles} badge="Virtually staged" preview>
  <div slot="gallery">
    <div class="mt-10 space-y-14">
      {pairs.map((p, i) => <BeforeAfterSlider before={p.before} after={p.after} room={roomOf(p.name)} eager={i === 0} />)}
    </div>
    {singles.length > 0 && <PortfolioGallery photos={singles} badge="Virtually staged" />}
  </div>

  <div class="mt-14 rounded-2xl border border-stone-200 bg-white px-8 py-8 text-center shadow-sm">
    <h2 class="font-serif text-2xl text-stone-900">Have a vacant listing?</h2>
    <p class="mx-auto mt-2 max-w-lg text-pretty text-stone-600">
      Send the empty-room photos and I'll stage them digitally — no furniture rental, no movers.
    </p>
    <a
      href="/contact/?service=custom"
      class="mt-5 inline-flex min-h-[48px] items-center justify-center rounded-full bg-stone-900 px-8 text-sm font-medium text-white transition hover:bg-stone-700"
    >
      Get a staging quote →
    </a>
  </div>
</PortfolioCategoryLayout>
