---
// Portfolio grid + lightbox (All work and the category pages). One per page.
// Photos with `cats` can be filtered in place: dispatch a `portfolio:filter`
// event on document with the category id (or 'all') — see PortfolioBrowser.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: { meta: ImageMetadata; alt: string; cats?: string[] }[];
  /** category shown initially; other photos render hidden */
  filter?: string;
  /** small label on every card and in the lightbox, e.g. "Virtually staged" */
  badge?: string;
}
const { photos, filter = 'all', badge } = Astro.props;
const alts = photos.map((p) => p.alt);
const full = await Promise.all(photos.map((p) => getImage({ src: p.meta, format: 'webp', width: 1600 })));
const fullUrls = full.map((f) => f.src);
const inFilter = (cats?: string[]) => filter === 'all' || (cats ?? []).includes(filter);
---
<div id="gallery" class="mt-10 grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3">
  {photos.map((p, i) => (
    <button
      type="button"
      data-i={i}
      data-cats={(p.cats ?? []).join(' ')}
      hidden={!inFilter(p.cats)}
      aria-label={`View image ${i + 1} larger`}
      class="pg-card group relative block aspect-[4/3] w-full animate-pulse overflow-hidden rounded-sm bg-stone-200 shadow-sm transition duration-300 hover:-translate-y-3 hover:shadow-lg cursor-pointer"
    >
      <Image
        src={p.meta}
        alt={alts[i]}
        widths={[400, 800]}
        sizes="(max-width: 640px) 50vw, 33vw"
        format="avif"
        quality={74}
        loading="lazy"
        decoding="async"
        class="pg-img h-full w-full object-cover opacity-0 transition-opacity duration-700"
      />
      {badge && (
        <span class="absolute bottom-2 left-2 rounded-full bg-black/60 px-2.5 py-1 text-[10px] font-medium uppercase tracking-wider text-white">
          {badge}
        </span>
      )}
    </button>
  ))}
</div>

<div
  id="lightbox"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 p-4"
>
  {badge && (
    <span class="absolute left-4 top-4 rounded-full bg-white/15 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-white">{badge}</span>
  )}
  <button data-close aria-label="Close" class="absolute right-3 top-3 inline-flex h-11 w-11 items-center justify-center rounded-full text-2xl text-white/90 hover:bg-white/10">×</button>
  <button data-prev aria-label="Previous" class="absolute left-2 inline-flex h-12 w-12 items-center justify-center rounded-full text-3xl text-white/90 hover:bg-white/10 sm:left-5">‹</button>
  <img id="lb-img" alt="" class="max-h-[88vh] max-w-[92vw] object-contain" />
  <button data-next aria-label="Next" class="absolute right-2 inline-flex h-12 w-12 items-center justify-center rounded-full text-3xl text-white/90 hover:bg-white/10 sm:right-5">›</button>
</div>

<script type="application/json" id="gallery-full" set:html={JSON.stringify(fullUrls)} />
<script type="application/json" id="gallery-alts" set:html={JSON.stringify(alts)} />

<script>
  const fulls: string[] = JSON.parse(document.getElementById('gallery-full')?.textContent || '[]');
  const alts: string[] = JSON.parse(document.getElementById('gallery-alts')?.textContent || '[]');
  const gallery = document.getElementById('gallery');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#gallery .pg-card'));
  const visible = () => cards.filter((c) => !c.hidden);

  // Lightbox — prev/next step through the photos currently shown.
  const lb = document.getElementById('lightbox') as HTMLElement;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  let pos = 0;
  const show = (p: number) => {
    const list = visible();
    if (!list.length) return;
    pos = (p + list.length) % list.length;
    const i = Number(list[pos].dataset.i);
    lbImg.src = fulls[i];
    lbImg.alt = alts[i] || '';
  };
  const open = (card: HTMLElement) => { show(visible().indexOf(card)); lb.hidden = false; document.body.style.overflow = 'hidden'; };
  const close = () => { lb.hidden = true; lbImg.removeAttribute('src'); document.body.style.overflow = ''; };
  cards.forEach((card) => card.addEventListener('click', () => open(card)));
  lb.querySelector('[data-close]')!.addEventListener('click', close);
  lb.querySelector('[data-prev]')!.addEventListener('click', () => show(pos - 1));
  lb.querySelector('[data-next]')!.addEventListener('click', () => show(pos + 1));
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') show(pos - 1);
    else if (e.key === 'ArrowRight') show(pos + 1);
  });
  let sx = 0;
  lb.addEventListener('touchstart', (e) => (sx = e.changedTouches[0].clientX), { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx;
    if (Math.abs(dx) > 50) show(pos + (dx < 0 ? 1 : -1));
  }, { passive: true });

  // Skeleton: reveal shown cards in display order (1,2,3...) so caching never
  // lets a later card jump ahead of an earlier one.
  const reveal = (card: HTMLElement) => {
    const img = card.querySelector<HTMLImageElement>('.pg-img')!;
    card.classList.remove('animate-pulse', 'bg-stone-200');
    img.classList.remove('opacity-0');
    img.classList.add('opacity-100');
  };
  const revealInOrder = () => {
    visible()
      .filter((c) => !c.dataset.queued)
      .forEach((card, n) => {
        card.dataset.queued = '1';
        const img = card.querySelector<HTMLImageElement>('.pg-img')!;
        setTimeout(() => {
          if (img.complete && img.naturalWidth > 0) reveal(card);
          else img.addEventListener('load', () => reveal(card), { once: true });
        }, n * 150);
      });
  };
  let started = false;
  const obs = new IntersectionObserver((entries) => {
    if (!entries[0].isIntersecting) return;
    obs.disconnect();
    started = true;
    revealInOrder();
  }, { threshold: 0.1 });
  if (gallery) obs.observe(gallery);

  // In-place category filter.
  document.addEventListener('portfolio:filter', (e) => {
    const id = (e as CustomEvent<string>).detail;
    cards.forEach((c) => { c.hidden = !(id === 'all' || (c.dataset.cats ?? '').split(' ').includes(id)); });
    gallery?.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 250, easing: 'ease-out' });
    if (started) revealInOrder();
  });
</script>
