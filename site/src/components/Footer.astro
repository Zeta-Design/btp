---
import { SITE } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-stone-200 sm:mt-32">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6">
    <div class="flex items-start justify-between gap-4 sm:items-end sm:gap-8">
      <div>
        <p class="font-serif text-2xl tracking-tight">{SITE.name}</p>
        <p class="mt-2 max-w-xs text-balance text-sm text-stone-500">{SITE.tagline}</p>
      </div>
      <a
        href="/contact/"
        class="inline-flex min-h-[48px] items-center justify-center self-start whitespace-nowrap rounded-full border border-stone-300 px-7 text-sm font-medium text-stone-800 transition hover:border-stone-500 hover:text-stone-950"
      >
        Contact me
      </a>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-stone-100 pt-6 text-sm text-stone-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.name}</p>
      <div class="flex flex-wrap items-center gap-x-6">
        <a href="/blog/" class="inline-flex min-h-[44px] items-center transition hover:text-stone-900">
          Blog
        </a>
        <a
          href="/gallery-lab/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center transition hover:text-stone-900"
        >
          3D Gallery
        </a>
        {
          SITE.social?.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[44px] items-center transition hover:text-stone-900"
            >
              {s.label}
            </a>
          ))
        }
        {
          SITE.email && (
            <a href={`mailto:${SITE.email}`} class="inline-flex min-h-[44px] items-center transition hover:text-stone-900">
              Email me
            </a>
          )
        }
        {
          SITE.clientPortalUrl && (
            <a
              href={SITE.clientPortalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[44px] items-center transition hover:text-stone-900"
            >
              Client Portal
            </a>
          )
        }
      </div>
    </div>
  </div>
</footer>
