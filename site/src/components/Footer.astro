---
import { SITE } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-stone-200">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-10 text-sm text-stone-500 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {SITE.name}</p>
    {SITE.email && <a href={`mailto:${SITE.email}`} class="hover:text-stone-800">{SITE.email}</a>}
    <a href="/inquire/" class="hover:text-stone-800">Start a project →</a>
  </div>
</footer>
