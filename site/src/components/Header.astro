---
import { Image } from 'astro:assets';
import { SITE } from '../config/site';
// Temporary logo — swap src/assets/logo.jpg for the final mark when ready.
import logo from '../assets/logo.png';

const links: { href: string; label: string; newTab?: boolean; cta?: boolean }[] = [
  { href: '/about/', label: 'About' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/contact/', label: 'Contact' },
  { href: '/book/', label: 'Book now', cta: true },
];
if (SITE.clientPortalUrl) {
  links.push({ href: SITE.clientPortalUrl, label: 'Client Portal', newTab: true });
}
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---
<header class="sticky top-0 z-40 border-b border-stone-200/80 bg-stone-50/85 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3 sm:px-6 sm:py-4">
    <a href="/" class="flex items-center gap-3" aria-label={`${SITE.name} — home`}>
      <Image src={logo} alt="" width={80} height={80} class="h-9 w-9 object-contain" />
      <span class="font-serif text-lg tracking-tight sm:text-xl">{SITE.name}</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-8 text-sm md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              target={l.newTab ? '_blank' : undefined}
              rel={l.newTab ? 'noopener noreferrer' : undefined}
              aria-current={!l.newTab && isActive(l.href) ? 'page' : undefined}
              class:list={[
                l.cta
                  ? 'inline-flex min-h-[36px] items-center rounded-full bg-stone-900 px-5 text-white transition hover:bg-stone-700'
                  : 'inline-flex min-h-[44px] items-center text-stone-600 transition-colors hover:text-stone-900',
                !l.cta && isActive(l.href) && 'font-medium text-stone-900',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile menu toggle -->
    <button
      id="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="-mr-2 inline-flex h-11 w-11 items-center justify-center text-stone-900 md:hidden"
    >
      <svg class="menu-open h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg class="menu-close hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile panel -->
  <div id="mobile-menu" hidden class="border-t border-stone-200 bg-stone-50 md:hidden">
    <ul class="mx-auto max-w-6xl divide-y divide-stone-100 px-5 py-2">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              target={l.newTab ? '_blank' : undefined}
              rel={l.newTab ? 'noopener noreferrer' : undefined}
              aria-current={!l.newTab && isActive(l.href) ? 'page' : undefined}
              class:list={[
                'flex min-h-[52px] items-center text-base',
                l.cta ? 'font-medium text-stone-900' : 'text-stone-700',
                !l.cta && isActive(l.href) && 'font-medium text-stone-900',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const openIcon = btn.querySelector('.menu-open');
    const closeIcon = btn.querySelector('.menu-close');
    const setState = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      (menu as HTMLElement).hidden = !open;
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () =>
      setState(btn.getAttribute('aria-expanded') !== 'true'),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setState(false);
    });
  }
</script>
