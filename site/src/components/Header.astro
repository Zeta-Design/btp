---
import { Image } from 'astro:assets';
import { SITE } from '../config/site';
// Temporary logo — swap src/assets/logo.jpg for the final mark when ready.
import logo from '../assets/logo.jpg';

const links = [
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="border-b border-stone-200">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href="/" class="flex items-center gap-3">
      <Image
        src={logo}
        alt={`${SITE.name} logo`}
        width={80}
        height={80}
        class="h-9 w-9 rounded-full object-cover"
      />
      <span class="font-serif text-xl tracking-tight">{SITE.name}</span>
    </a>
    <ul class="flex items-center gap-6 text-sm">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[
                'text-stone-600 transition hover:text-stone-900',
                path.startsWith(l.href) && 'underline underline-offset-4',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
