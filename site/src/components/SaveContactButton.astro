---
// Links to the /ben-tims.vcf contact card. No `download` attribute on purpose —
// it would make iOS save the file to Files instead of showing the contact card.
interface Props {
  label?: string;
  class?: string;
}
const {
  label = 'Save my contact',
  class: className = 'inline-flex min-h-[40px] items-center gap-2 text-sm text-stone-800 transition hover:text-stone-950',
} = Astro.props;
---
<a href="/ben-tims.vcf" class={className}>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
  </svg>
  {label}
</a>
