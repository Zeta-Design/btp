---
import { SITE } from '../config/site';

interface Props {
  showInfoSections?: boolean;
  filterType?: 'real-estate' | 'vacation-rental' | 'walkthrough-video' | 'twilight-standalone';
}
const { showInfoSections = true, filterType } = Astro.props;

/* Brands that define their own pricing sections (e.g. The BT Photography) render
   those generically below and skip every real-estate-specific section. */
const groups = SITE.pricingGroups;
const depositNote = SITE.depositNote ?? '$150 deposit · balance due after shoot';
const includedMap = groups
  ? Object.fromEntries(groups.map((g) => [g.service, g.included]))
  : null;

const reEstate = [
  { label: 'Up to 1,500 sq ft',    price: '$195', detail: 'Up to 25 photos' },
  { label: '1,500 – 2,500 sq ft',  price: '$235', detail: 'Up to 35 photos' },
  { label: '2,500 – 4,000 sq ft',  price: '$310', detail: 'Up to 40 photos' },
  { label: '4,000 – 5,500 sq ft',  price: '$395', detail: 'Up to 50 photos' },
  { label: '5,500 – 8,000 sq ft',  price: '$495', detail: 'Up to 60 photos' },
  { label: '8,000+ sq ft',          price: '$625', detail: 'Up to 70 photos' },
];

const vacRental = [
  { label: '1 – 2 Bedrooms',        price: '$280', detail: 'Up to 30 photos' },
  { label: '3 – 4 Bedrooms',        price: '$350', detail: 'Up to 40 photos' },
  { label: '4 – 5 Bedrooms',        price: '$445', detail: 'Up to 50 photos' },
  { label: '6+ Bedrooms',           price: '$575', detail: 'Up to 60 photos' },
  { label: '6+ Bedrooms — Premium', price: '$680', detail: 'Up to 70 photos incl. themed rooms, game room & pool' },
];

const showRE          = !groups && (!filterType || filterType === 'real-estate');
const showSTR         = !groups && (!filterType || filterType === 'vacation-rental');
const showVideo       = !groups && filterType === 'walkthrough-video';
const showTwilightSA  = !groups && filterType === 'twilight-standalone';
const showAddOns      = !groups && showInfoSections;
---
<style is:global>
  #btp-backdrop {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.65);
    backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
    z-index: 45; opacity: 0; pointer-events: none;
    transition: opacity 0.35s ease;
  }
  #btp-backdrop.active { opacity: 1; pointer-events: auto; }

  .btp-card { cursor: pointer; transform-origin: center; }
  .btp-card.is-folding {
    transition: transform 0.22s ease-in, opacity 0.18s ease;
    transform: perspective(1400px) rotateY(90deg); opacity: 0; pointer-events: none;
  }
  .btp-card.is-restoring {
    transition: transform 0.38s cubic-bezier(0.34,1.1,0.64,1), opacity 0.28s ease;
    transform: perspective(1400px) rotateY(0deg); opacity: 1;
  }

  #btp-modal-wrap {
    position: fixed; inset: 0; z-index: 50;
    display: flex; align-items: center; justify-content: center;
    padding: 1.25rem; pointer-events: none;
  }
  #btp-modal-wrap.active { pointer-events: auto; }

  #btp-modal-card {
    width: min(540px, 94vw); background: #1c1917;
    border-radius: 0.875rem; box-shadow: 0 40px 100px rgba(0,0,0,0.6);
    display: flex; flex-direction: column;
    opacity: 0; transform: perspective(1400px) rotateY(-90deg); transition: none;
  }
  #btp-modal-card.entering {
    transition: transform 0.48s cubic-bezier(0.34,1.06,0.64,1), opacity 0.22s ease;
    opacity: 1; transform: perspective(1400px) rotateY(0deg);
  }
  #btp-modal-card.leaving {
    transition: transform 0.28s ease-in, opacity 0.22s ease;
    opacity: 0; transform: perspective(1400px) rotateY(90deg);
  }
</style>

{groups && groups.map((g) => (
  <div id={g.id} class="mt-14">
    <h2 class="font-serif text-2xl sm:text-3xl">{g.title}</h2>
    <p class="mt-2 text-sm text-stone-500">{g.subtitle}</p>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {g.tiers.map((tier) => (
        <div
          class="btp-card rounded-xl border border-stone-200 bg-white p-6 flex flex-col justify-between hover:border-stone-400 hover:shadow-sm transition-shadow"
          style="min-height:180px;"
          data-category={g.title}
          data-label={tier.label}
          data-price={tier.price}
          data-detail={tier.detail}
          data-duration={g.duration ?? ''}
          data-service={g.service}
          data-tier={`${g.title} – ${tier.label}`}
          data-calendly={g.bookUrl}
        >
          <div>
            <p class="text-xs font-medium uppercase tracking-widest text-stone-500">{tier.label}</p>
            <p class="mt-3 text-2xl font-light text-stone-900">{tier.price}</p>
          </div>
          <div class="mt-4 flex items-center justify-between">
            <p class="text-sm text-stone-500">{tier.detail}</p>
            <span class="text-xs text-stone-500">tap to book →</span>
          </div>
        </div>
      ))}
    </div>
  </div>
))}

{includedMap && (
  <script type="application/json" id="btp-included" set:html={JSON.stringify(includedMap)} />
)}

{(showRE || showSTR) && !filterType && (
  <div class="mt-14">
    <h2 class="font-serif text-2xl sm:text-3xl">Which package is right for me?</h2>
    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      <div
        class="btp-card rounded-xl border border-stone-200 bg-white p-6 flex flex-col justify-between hover:border-stone-400 hover:shadow-sm transition-shadow"
        style="min-height:180px;"
        data-info="true"
        data-category="Which is right for me?"
        data-label="Real Estate Photography"
        data-tagline="Priced by sq ft · 2.5 hr shoot"
        data-detail="For agents & sellers"
        data-duration="2.5 hr shoot"
        data-service="real-estate-info"
        data-scroll-to="re-section"
      >
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-stone-500">Selling the property?</p>
          <p class="mt-3 text-2xl font-light text-stone-900">Real Estate</p>
        </div>
        <div class="mt-4 flex items-center justify-between">
          <p class="text-sm text-stone-500">Agents · sellers · MLS listings</p>
          <span class="text-xs text-stone-500">tap to learn more →</span>
        </div>
      </div>
      <div
        class="btp-card rounded-xl border border-stone-200 bg-white p-6 flex flex-col justify-between hover:border-stone-400 hover:shadow-sm transition-shadow"
        style="min-height:180px;"
        data-info="true"
        data-category="Which is right for me?"
        data-label="Vacation Rental Photography"
        data-tagline="Priced by bedrooms · 4 hr shoot"
        data-detail="For Airbnb & VRBO hosts"
        data-duration="4 hr shoot"
        data-service="vacation-rental-info"
        data-scroll-to="str-section"
      >
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-stone-500">Renting on Airbnb or VRBO?</p>
          <p class="mt-3 text-2xl font-light text-stone-900">Vacation Rental</p>
        </div>
        <div class="mt-4 flex items-center justify-between">
          <p class="text-sm text-stone-500">Airbnb · VRBO · short-term rentals</p>
          <span class="text-xs text-stone-500">tap to learn more →</span>
        </div>
      </div>
    </div>
  </div>
)}

{showRE && (
  <div id="re-section" class="mt-14">
    <h2 class="font-serif text-2xl sm:text-3xl">Real Estate</h2>
    <p class="mt-2 text-sm text-stone-500">MLS &amp; for-sale listings — priced by square footage</p>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {reEstate.map((tier) => (
        <div
          class="btp-card rounded-xl border border-stone-200 bg-white p-6 flex flex-col justify-between hover:border-stone-400 hover:shadow-sm transition-shadow"
          style="min-height:180px;"
          data-category="Real Estate Photography"
          data-label={tier.label}
          data-price={tier.price}
          data-detail={tier.detail}
          data-duration="2 hr 30 min"
          data-service="real-estate"
          data-tier={`Real Estate – ${tier.label}`}
          data-calendly="https://calendly.com/benjammintims/30min"
        >
          <div>
            <p class="text-xs font-medium uppercase tracking-widest text-stone-500">{tier.label}</p>
            <p class="mt-3 text-2xl font-light text-stone-900">{tier.price}</p>
          </div>
          <div class="mt-4 flex items-center justify-between">
            <p class="text-sm text-stone-500">{tier.detail} · 2.5 hr shoot</p>
            <span class="text-xs text-stone-500">tap to book →</span>
          </div>
        </div>
      ))}
    </div>
  </div>
)}

{showSTR && (
  <div id="str-section" class="mt-14">
    <h2 class="font-serif text-2xl sm:text-3xl">Vacation Rental &amp; STR</h2>
    <p class="mt-2 text-sm text-stone-500">Airbnb, VRBO &amp; short-term rentals — priced by bedrooms</p>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {vacRental.map((tier) => (
        <div
          class="btp-card rounded-xl border border-stone-200 bg-white p-6 flex flex-col justify-between hover:border-stone-400 hover:shadow-sm transition-shadow"
          style="min-height:180px;"
          data-category="Vacation Rental Photography"
          data-label={tier.label}
          data-price={tier.price}
          data-detail={tier.detail}
          data-duration="4 hr"
          data-service="vacation-rental"
          data-tier={`Vacation Rental – ${tier.label}`}
          data-calendly="https://calendly.com/benjammintims/vacation-rental-photography"
        >
          <div>
            <p class="text-xs font-medium uppercase tracking-widest text-stone-500">{tier.label}</p>
            <p class="mt-3 text-2xl font-light text-stone-900">{tier.price}</p>
          </div>
          <div class="mt-4 flex items-center justify-between">
            <p class="text-sm text-stone-500">{tier.detail} · 4 hr shoot</p>
            <span class="text-xs text-stone-500">tap to book →</span>
          </div>
        </div>
      ))}
    </div>
  </div>
)}

{showVideo && (
  <div class="mt-14">
    <h2 class="font-serif text-2xl sm:text-3xl">Walkthrough Video</h2>
    <p class="mt-2 text-sm text-stone-500">Standalone shoot — no photo package required</p>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <div
        class="btp-card rounded-xl border border-stone-200 bg-white p-6 flex flex-col justify-between hover:border-stone-400 hover:shadow-sm transition-shadow"
        style="min-height:180px;"
        data-category="Walkthrough Video"
        data-label="Standalone Shoot"
        data-price="$340"
        data-detail="Full walkthrough + social reel"
        data-duration="~2 hr"
        data-service="walkthrough-video"
        data-tier="Walkthrough Video – Standalone"
        data-calendly="https://calendly.com/benjammintims/30min"
      >
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-stone-500">Standalone</p>
          <p class="mt-3 text-2xl font-light text-stone-900">$340</p>
        </div>
        <div class="mt-4 flex items-center justify-between">
          <p class="text-sm text-stone-500">Gimbal walkthrough + social reel · 24–48 hrs</p>
          <span class="text-xs text-stone-500">tap to book →</span>
        </div>
      </div>
    </div>
  </div>
)}

{showTwilightSA && (
  <div class="mt-14">
    <h2 class="font-serif text-2xl sm:text-3xl">Twilight Session</h2>
    <p class="mt-2 text-sm text-stone-500">Standalone shoot — separate appointment</p>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <div
        class="btp-card rounded-xl border border-stone-200 bg-white p-6 flex flex-col justify-between hover:border-stone-400 hover:shadow-sm transition-shadow"
        style="min-height:180px;"
        data-category="Twilight Session"
        data-label="Standalone Shoot"
        data-price="$210"
        data-detail="6–8 dusk/twilight exterior photos"
        data-duration="~1 hr"
        data-service="twilight-standalone"
        data-tier="Twilight Session – Standalone"
        data-calendly="https://calendly.com/benjammintims/30min"
      >
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-stone-500">Standalone</p>
          <p class="mt-3 text-2xl font-light text-stone-900">$210</p>
        </div>
        <div class="mt-4 flex items-center justify-between">
          <p class="text-sm text-stone-500">6–8 twilight exterior photos · 24–48 hrs</p>
          <span class="text-xs text-stone-500">tap to book →</span>
        </div>
      </div>
    </div>
  </div>
)}

{showAddOns && (
  <>
    <div class="mt-14">
      <h2 class="font-serif text-2xl sm:text-3xl">Walkthrough Video</h2>
      <p class="mt-2 text-sm text-stone-500">Gimbal walkthrough + a 30–60 sec vertical social reel — one shoot, two deliverables</p>
      <div class="mt-6 divide-y divide-stone-100 rounded-xl border border-stone-200 bg-white">
        {[
          { label: 'Add-on — same day as photo shoot', price: '$210', detail: 'Booked alongside any photo package — full walkthrough edit + social reel cut' },
          { label: 'Standalone shoot',                 price: '$340', detail: 'Separate appointment — full walkthrough edit + social reel cut' },
        ].map((item) => (
          <div class="flex items-center justify-between gap-6 px-6 py-5">
            <div>
              <p class="font-medium text-stone-900">{item.label}</p>
              <p class="mt-0.5 text-sm text-stone-500">{item.detail}</p>
            </div>
            <p class="shrink-0 text-base font-light text-stone-900">{item.price}</p>
          </div>
        ))}
      </div>
      <p class="mt-3 text-xs text-stone-500">Video add-on can be selected during checkout after scheduling.</p>
    </div>

    <div class="mt-14">
      <h2 class="font-serif text-2xl sm:text-3xl">Add-ons</h2>
      <div class="mt-6 divide-y divide-stone-100 rounded-xl border border-stone-200 bg-white">
        {[
          { label: 'Twilight Session — Add-on',    price: '$155',        detail: '6–8 dusk/twilight exterior photos, booked same day as main shoot' },
          { label: 'Twilight Session — Standalone', price: '$210',        detail: '6–8 dusk/twilight exterior photos, separate appointment' },
          { label: 'Virtual Twilight Edit',         price: '$35 / image', detail: 'Daytime exterior digitally converted to a twilight look' },
        ].map((item) => (
          <div class="flex items-center justify-between gap-6 px-6 py-5">
            <div>
              <p class="font-medium text-stone-900">{item.label}</p>
              <p class="mt-0.5 text-sm text-stone-500">{item.detail}</p>
            </div>
            <p class="shrink-0 text-base font-light text-stone-900">{item.price}</p>
          </div>
        ))}
      </div>
      <p class="mt-3 text-xs text-stone-500">Add-ons can be selected during checkout after scheduling your shoot.</p>
    </div>
  </>
)}

<!-- Calendly popup widget assets -->
<link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
<script is:inline src="https://assets.calendly.com/assets/external/widget.js"></script>

<div id="btp-backdrop"></div>

<div id="btp-modal-wrap" aria-hidden="true" inert>
  <div id="btp-modal-card" role="dialog" aria-modal="true" aria-labelledby="btm-label">
    <div class="p-8 pb-6">
      <button id="btm-close" class="-ml-1 mb-4 inline-flex items-center text-sm text-stone-400 transition hover:text-stone-200">← back</button>
      <p id="btm-cat"   class="text-xs font-medium uppercase tracking-widest text-stone-400"></p>
      <p id="btm-label" class="mt-3 font-serif text-2xl leading-snug text-white"></p>
      <p id="btm-price" class="mt-2 text-5xl font-light text-white"></p>
      <p id="btm-tagline" class="mt-2 text-base text-stone-300"></p>
      <div id="btm-badges" class="mt-5 flex flex-wrap gap-2"></div>
      <p id="btm-deposit" class="mt-4 text-sm text-stone-400">{depositNote}</p>
      <div class="mt-6 border-t border-stone-800 pt-5">
        <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">What's included</p>
        <ul id="btm-included" class="mt-3 space-y-2"></ul>
      </div>
    </div>
    <div class="border-t border-stone-800 px-8 py-5">
      <a id="btm-book" href="#" class="block w-full rounded-full bg-white py-3.5 text-center text-base font-medium text-stone-900 transition hover:bg-stone-100">Book</a>
    </div>
  </div>
</div>

<script>
  const backdrop = document.getElementById('btp-backdrop');
  if (backdrop) {
    const modalWrap  = document.getElementById('btp-modal-wrap')!;
    const modalCard  = document.getElementById('btp-modal-card')!;
    const btmCat      = document.getElementById('btm-cat')!;
    const btmLabel    = document.getElementById('btm-label')!;
    const btmPrice    = document.getElementById('btm-price')!;
    const btmTagline  = document.getElementById('btm-tagline')!;
    const btmBadges   = document.getElementById('btm-badges')!;
    const btmIncluded = document.getElementById('btm-included')!;
    const btmDeposit  = document.getElementById('btm-deposit')!;
    const btmBook     = document.getElementById('btm-book') as HTMLAnchorElement;
    const btmClose    = document.getElementById('btm-close') as HTMLButtonElement;

    const INCLUDED: Record<string, string[]> = {
      'real-estate-info': [
        'Best for listing agents, sellers &amp; property managers',
        'Efficient 2.5 hr shoot — bright, clean, MLS-optimized photos',
        'Priced by square footage — simple and predictable',
        'One-time use: your photos get the property sold, fast',
        'HDR-edited JPEGs licensed for MLS &amp; social media',
        'Delivery within 24–48 hours',
      ],
      'vacation-rental-info': [
        'Best for Airbnb, VRBO &amp; short-term rental hosts',
        'Styled 4 hr shoot — staging tips, amenity highlights, lifestyle feel',
        'Priced by bedrooms — scales with your property',
        'Long-term investment: photos work for you across years of bookings',
        'Platform-ready JPEGs licensed for Airbnb, VRBO &amp; all marketing',
        'Delivery within 24–48 hours',
      ],
      'real-estate': [
        'Professional HDR editing on every image',
        'MLS-ready JPEGs delivered via online gallery',
        'Delivery within 24–48 hours of your shoot',
        'Licensed for MLS, listing sites &amp; social media',
        'Unlimited downloads — no watermarks',
      ],
      'vacation-rental': [
        'Professional HDR editing on every image',
        'High-res JPEGs delivered via online gallery',
        'Delivery within 24–48 hours of your shoot',
        'Licensed for Airbnb, VRBO &amp; marketing use',
        'Styled staging suggestions included',
        'Unlimited downloads — no watermarks',
      ],
      'walkthrough-video': [
        'Full gimbal stabilizer walkthrough of the property',
        '30–60 second vertical social media reel cut',
        'Professional color grade and background music',
        'Delivery within 24–48 hours',
        'Licensed for all platforms — Instagram, Facebook, TikTok, MLS',
        'Unlimited downloads — no watermarks',
      ],
      'twilight-standalone': [
        '6–8 professional dusk/twilight exterior photos',
        'Professional HDR editing on every image',
        'High-res JPEGs delivered via online gallery',
        'Delivery within 24–48 hours of your shoot',
        'Licensed for MLS, listing sites &amp; social media',
        'Unlimited downloads — no watermarks',
      ],
    };

    // Brands with their own pricing sections ship their "What's included" lists
    // as JSON so this map covers whatever services that brand defines.
    const includedEl = document.getElementById('btp-included');
    if (includedEl) Object.assign(INCLUDED, JSON.parse(includedEl.textContent || '{}'));

    let activeCard: HTMLElement | null = null;
    let closing = false;

    function openModal(card: HTMLElement) {
      if (activeCard || closing) return;
      activeCard = card;
      const { category, label, price, detail, duration, service, tier, calendly, info, tagline, scrollTo } = card.dataset;
      const isInfo = info === 'true';
      btmCat.textContent   = category!;
      btmLabel.textContent = label!;
      btmPrice.textContent = isInfo ? '' : price!;
      btmPrice.style.display = isInfo ? 'none' : '';
      btmTagline.textContent = isInfo ? tagline! : '';
      btmTagline.style.display = isInfo ? '' : 'none';
      btmDeposit.style.display = isInfo ? 'none' : '';
      btmBadges.innerHTML  = [duration!, detail!, ...(isInfo ? [] : ['24–48 hr delivery'])]
        .filter(Boolean)
        .map(b => `<span class="rounded-full bg-stone-800 px-4 py-1.5 text-sm text-stone-300">${b}</span>`)
        .join('');
      btmIncluded.innerHTML = (INCLUDED[service!] ?? INCLUDED['real-estate'])
        .map(item => `<li class="flex items-start gap-2 text-sm text-stone-300"><span class="mt-0.5 shrink-0 text-stone-400">→</span>${item}</li>`)
        .join('');
      btmBook.textContent      = isInfo ? 'See pricing ↓' : 'Book';
      btmBook.href             = isInfo ? `#${scrollTo}` : calendly!;
      btmBook.dataset.isInfo   = isInfo ? 'true' : '';
      btmBook.dataset.scrollTo = scrollTo ?? '';
      btmBook.dataset.service  = service;
      btmBook.dataset.tier     = tier;
      btmBook.dataset.price    = price;
      card.classList.add('is-folding');
      backdrop.classList.add('active');
      document.body.style.overflow = 'hidden';
      modalWrap.classList.add('active');
      modalWrap.removeAttribute('inert');
      modalWrap.setAttribute('aria-hidden', 'false');
      modalCard.classList.remove('entering', 'leaving');
      void modalCard.offsetWidth;
      setTimeout(() => modalCard.classList.add('entering'), 130);
      // Move keyboard focus into the dialog once it's visible
      setTimeout(() => btmBook.focus(), 200);
    }

    function closeModal() {
      if (!activeCard || closing) return;
      closing = true;
      const card = activeCard;
      activeCard = null;
      // Return keyboard focus to the card that opened the dialog
      setTimeout(() => card.focus(), 0);
      modalCard.classList.remove('entering');
      modalCard.classList.add('leaving');
      backdrop.classList.remove('active');
      document.body.style.overflow = '';
      setTimeout(() => {
        card.classList.remove('is-folding');
        card.classList.add('is-restoring');
        card.addEventListener('transitionend', () => card.classList.remove('is-restoring'), { once: true });
      }, 120);
      setTimeout(() => {
        modalWrap.classList.remove('active');
        modalWrap.setAttribute('inert', '');
        modalWrap.setAttribute('aria-hidden', 'true');
        modalCard.classList.remove('leaving');
        closing = false;
      }, 320);
    }

    document.querySelectorAll<HTMLElement>('.btp-card').forEach(card => {
      // Make the div behave as a real button for keyboard + AT users
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');
      card.setAttribute('aria-haspopup', 'dialog');
      card.addEventListener('click', () => openModal(card));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
          e.preventDefault();
          openModal(card);
        }
      });
    });
    modalCard.addEventListener('click', e => e.stopPropagation());
    btmClose.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
    modalWrap.addEventListener('click', closeModal);
    document.addEventListener('keydown', e => {
      if (!activeCard && !closing) return;   // dialog not open
      if (e.key === 'Escape') { closeModal(); return; }
      // Trap Tab within the dialog's focusable controls
      if (e.key === 'Tab') {
        const focusables = [btmBook, btmClose];
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        } else if (!focusables.includes(document.activeElement as any)) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    btmBook.addEventListener('click', (e) => {
      e.preventDefault();
      if (btmBook.dataset.isInfo === 'true') {
        const scrollTo = btmBook.dataset.scrollTo;
        closeModal();
        setTimeout(() => {
          document.getElementById(scrollTo!)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 350);
        return;
      }
      const price   = btmBook.dataset.price   ?? '';
      const tier    = btmBook.dataset.tier    ?? '';
      const service = btmBook.dataset.service ?? '';
      localStorage.setItem('btpBooking', JSON.stringify({ service, tier, price }));

      // Brands without Calendly scheduling (e.g. The BT Photography) point their
      // Book button at an inquiry page — just follow the link.
      if (!btmBook.href.includes('calendly.com')) {
        const dest = btmBook.href;
        closeModal();
        window.location.href = dest;
        return;
      }

      const calendlyUrl = new URL(btmBook.href);
      calendlyUrl.searchParams.set('utm_content', price);
      calendlyUrl.searchParams.set('utm_term', tier);

      closeModal();

      const Cal = (window as any).Calendly;
      if (Cal) {
        Cal.initPopupWidget({ url: calendlyUrl.toString() });
      } else {
        // Script still loading — wait then open, or fall back to navigation
        const s = document.querySelector('script[src*="assets.calendly.com"]') as HTMLScriptElement | null;
        if (s) {
          s.addEventListener('load', () => (window as any).Calendly?.initPopupWidget({ url: calendlyUrl.toString() }), { once: true });
        } else {
          window.location.href = calendlyUrl.toString();
        }
      }
    });

    // After Calendly booking completes, redirect to Step 2 without the interstitial.
    // Name/email pre-fill is lost (user fills them in on Step 2); everything else
    // comes from localStorage set above.
    window.addEventListener('message', (e) => {
      if (e.origin === 'https://calendly.com' && e.data?.event === 'calendly.event_scheduled') {
        const stored = localStorage.getItem('btpBooking');
        if (stored) {
          try {
            const { service } = JSON.parse(stored);
            if (service) {
              setTimeout(() => {
                (window as any).Calendly?.closePopupWidget?.();
                window.location.href = `/book?service=${encodeURIComponent(service)}`;
              }, 1200);
            }
          } catch {}
        }
      }
    });
  }
</script>
