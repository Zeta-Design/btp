---
import BaseLayout from '../layouts/BaseLayout.astro';
import PackageCards from '../components/PackageCards.astro';
import { SITE } from '../config/site';

const isCustomPricing = !!SITE.pricingGroups;
const copy = SITE.pricingCopy ?? {
  heading: 'Simple, transparent rates',
  intro:
    'No hidden fees. Every shoot includes professional editing and delivery within 24–48 hours. Click any package to book.',
};
---
<BaseLayout
  title={isCustomPricing ? 'Event & Portrait Photography Pricing' : 'Real Estate & Airbnb Photography Pricing'}
  description={isCustomPricing
    ? `Event, portrait & headshot photography pricing from ${SITE.name} — editing and a private online gallery included.`
    : `Transparent real estate & short-term rental photography pricing. Priced by square footage or bedrooms — editing and 24–48 hr delivery included.`}
>
  <section class="mx-auto max-w-5xl px-5 py-14 sm:px-6 sm:py-20">
    <p class="text-xs uppercase tracking-[0.25em] text-stone-500">Pricing</p>
    <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2.25rem,7vw,4rem)]">{copy.heading}</h1>
    <p class="mt-4 max-w-xl text-pretty text-stone-600">{copy.intro}</p>

    <PackageCards />

    <!-- Custom / one-off shoot (real-estate brands only) -->
    {!isCustomPricing && (
    <div class="mt-10 rounded-2xl border border-stone-200 bg-white px-8 py-8 text-center shadow-sm">
      <h2 class="font-serif text-2xl text-stone-900">Need just one thing?</h2>
      <p class="mx-auto mt-2 max-w-lg text-pretty text-stone-600">
        A pool, a single room, one exterior, a renovation reveal — anything that isn't a standard
        package. Tell me what you have in mind and I'll send a custom quote.
      </p>
      <a
        href="/contact/?service=custom"
        class="mt-5 inline-flex min-h-[48px] items-center justify-center rounded-full bg-stone-900 px-8 text-sm font-medium text-white transition hover:bg-stone-700"
      >
        Get a custom quote →
      </a>
    </div>
    )}

    <!-- Bundle / portfolio package (real-estate brands only) -->
    {!isCustomPricing && (
    <div class="mt-14 rounded-2xl border border-stone-200 bg-white px-8 py-10 text-center shadow-sm">
      <p class="text-xs uppercase tracking-[0.25em] text-stone-500">Portfolio packages</p>
      <h2 class="mt-3 font-serif text-2xl text-stone-900 sm:text-3xl">Multiple properties?</h2>
      <p class="mx-auto mt-3 max-w-xl text-pretty text-stone-600">
        Booking several listings or a short-term rental portfolio together earns a discounted
        portfolio-package rate. Send me the number of properties and the bedroom count of each,
        and I'll reply with an exact quote and scheduling.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/contact/?service=bundle"
          class="inline-flex min-h-[48px] w-full max-w-xs items-center justify-center rounded-full bg-stone-900 px-8 text-sm font-medium text-white transition hover:bg-stone-700 sm:w-auto sm:max-w-none"
        >
          Get a bundle quote →
        </a>
        {SITE.phone && (
          <a
            href={`tel:+1${SITE.phone.replace(/\D/g, '')}`}
            class="inline-flex min-h-[48px] w-full max-w-xs items-center justify-center rounded-full border border-stone-300 px-8 text-sm font-medium text-stone-800 transition hover:bg-stone-100 sm:w-auto sm:max-w-none"
          >
            Call or text {SITE.phone}
          </a>
        )}
      </div>
    </div>
    )}

    <!-- CTA -->
    <div class="mt-8 rounded-2xl bg-stone-900 px-8 py-10 text-center">
      <h2 class="font-serif text-2xl text-stone-50 sm:text-3xl">Ready to book?</h2>
      <p class="mt-3 text-stone-400">
        {isCustomPricing
          ? SITE.depositNote ?? 'Get in touch to lock in your date.'
          : 'Reserve your date with a $150 deposit, charged once I confirm your booking. Balance due after your shoot.'}
      </p>
      <a
        href={isCustomPricing ? '/contact/' : '/book/'}
        class="mt-6 inline-flex min-h-[48px] items-center justify-center rounded-full bg-white px-8 text-sm font-medium text-stone-900 transition hover:bg-stone-100"
      >
        {isCustomPricing ? 'Check availability →' : 'Book & pay deposit →'}
      </a>
    </div>
  </section>
</BaseLayout>
