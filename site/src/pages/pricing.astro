---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---
<BaseLayout
  title="Pricing"
  description={`Real estate and vacation rental photography pricing by ${SITE.name}. Serving Florida and Texas.`}
>
  <section class="mx-auto max-w-5xl px-5 py-14 sm:px-6 sm:py-20">
    <p class="text-xs uppercase tracking-[0.25em] text-stone-400">Pricing</p>
    <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2.25rem,7vw,4rem)]">Simple, transparent rates</h1>
    <p class="mt-4 max-w-xl text-pretty text-stone-600">
      No hidden fees. Every shoot includes professional editing and delivery within 24–48 hours.
    </p>

    <!-- Real Estate -->
    <div class="mt-14">
      <h2 class="font-serif text-2xl sm:text-3xl">Real Estate</h2>
      <p class="mt-2 text-sm text-stone-500">MLS &amp; for-sale listings — priced by square footage</p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { label: 'Up to 1,500 sq ft', price: '$185', detail: 'Up to 25 photos' },
          { label: '1,500 – 2,500 sq ft', price: '$225', detail: 'Up to 35 photos' },
          { label: '2,500 – 4,000 sq ft', price: '$295', detail: 'Up to 40 photos' },
          { label: '4,000 – 5,500 sq ft', price: '$375', detail: 'Up to 50 photos' },
          { label: '5,500 – 8,000 sq ft', price: '$475', detail: 'Up to 60 photos' },
          { label: '8,000+ sq ft', price: '$595', detail: 'Up to 70 photos' },
        ].map((tier) => (
          <div class="flex flex-col justify-between rounded-xl border border-stone-200 bg-white p-6">
            <div>
              <p class="text-xs font-medium uppercase tracking-widest text-stone-400">{tier.label}</p>
              <p class="mt-3 text-2xl font-light text-stone-900">{tier.price}</p>
            </div>
            <p class="mt-4 text-sm text-stone-500">{tier.detail} · delivered within 24–48 hrs</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Vacation Rental -->
    <div class="mt-14">
      <h2 class="font-serif text-2xl sm:text-3xl">Vacation Rental &amp; STR</h2>
      <p class="mt-2 text-sm text-stone-500">Airbnb, VRBO &amp; short-term rentals — priced by bedrooms</p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { label: '1 – 2 Bedrooms', price: '$265', detail: 'Up to 30 professionally edited photos' },
          { label: '3 – 4 Bedrooms', price: '$335', detail: 'Up to 40 professionally edited photos' },
          { label: '4 – 5 Bedrooms', price: '$425', detail: 'Up to 50 professionally edited photos' },
          { label: '6+ Bedrooms', price: '$550', detail: 'Up to 60 professionally edited photos' },
          { label: '6+ Bedrooms — Premium', price: '$650', detail: 'Up to 70 professionally edited photos incl. themed rooms, game room & pool' },
        ].map((tier) => (
          <div class="flex flex-col justify-between rounded-xl border border-stone-200 bg-white p-6">
            <div>
              <p class="text-xs font-medium uppercase tracking-widest text-stone-400">{tier.label}</p>
              <p class="mt-3 text-2xl font-light text-stone-900">{tier.price}</p>
            </div>
            <p class="mt-4 text-sm text-stone-500">{tier.detail} · delivered within 24–48 hrs</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Video -->
    <div class="mt-14">
      <h2 class="font-serif text-2xl sm:text-3xl">Walkthrough Video</h2>
      <p class="mt-2 text-sm text-stone-500">Gimbal walkthrough + a 30–60 sec vertical social reel — one shoot, two deliverables</p>
      <div class="mt-6 divide-y divide-stone-100 rounded-xl border border-stone-200 bg-white">
        {[
          { label: 'Add-on — same day as photo shoot', price: '$200', detail: 'Booked alongside any photo package — full walkthrough edit + social reel cut' },
          { label: 'Standalone shoot', price: '$325', detail: 'Separate appointment — full walkthrough edit + social reel cut' },
        ].map((item) => (
          <div class="flex items-center justify-between gap-6 px-6 py-5">
            <div>
              <p class="font-medium text-stone-900">{item.label}</p>
              <p class="mt-0.5 text-sm text-stone-500">{item.detail}</p>
            </div>
            <p class="shrink-0 text-base font-light text-stone-900">{item.price}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Add-ons -->
    <div class="mt-14">
      <h2 class="font-serif text-2xl sm:text-3xl">Add-ons</h2>
      <div class="mt-6 divide-y divide-stone-100 rounded-xl border border-stone-200 bg-white">
        {[
          { label: 'Twilight Session — Add-on', price: '$150', detail: '6–8 dusk/twilight exterior photos, booked same day as main shoot' },
          { label: 'Twilight Session — Standalone', price: '$200', detail: '6–8 dusk/twilight exterior photos, separate appointment' },
          { label: 'Virtual Twilight Edit', price: '$35 / image', detail: 'Daytime exterior digitally converted to a twilight look' },
        ].map((item) => (
          <div class="flex items-center justify-between gap-6 px-6 py-5">
            <div>
              <p class="font-medium text-stone-900">{item.label}</p>
              <p class="mt-0.5 text-sm text-stone-500">{item.detail}</p>
            </div>
            <p class="shrink-0 text-base font-light text-stone-900">{item.price}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-14 rounded-2xl bg-stone-900 px-8 py-10 text-center">
      <h2 class="font-serif text-2xl text-stone-50 sm:text-3xl">Ready to book?</h2>
      <p class="mt-3 text-stone-400">Secure your date with a $150 deposit — balance due after your shoot.</p>
      <a
        href="/book/"
        class="mt-6 inline-flex min-h-[48px] items-center justify-center rounded-full bg-white px-8 text-sm font-medium text-stone-900 transition hover:bg-stone-100"
      >
        Book &amp; pay deposit →
      </a>
    </div>
  </section>
</BaseLayout>
