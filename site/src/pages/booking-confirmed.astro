---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import Stripe from 'stripe';

const sessionId = Astro.url.searchParams.get('session_id') ?? '';

let serviceTitle = 'Photography Session';
let tierTitle    = '';
let address      = '';
let isPaidInFull = false;
let gcalUrl: string | null = null;
let icsDataUri:  string | null = null;

if (sessionId) {
  try {
    const stripe  = new Stripe(import.meta.env.STRIPE_SECRET_KEY as string);
    const session = await stripe.checkout.sessions.retrieve(sessionId);
    const meta    = session.metadata ?? {};

    serviceTitle = meta.service ?? 'Photography Session';
    tierTitle    = meta.tier    ?? '';
    address      = meta.address ?? '';
    isPaidInFull = meta.paymentOption === 'full';

    const shootDate = meta.shootDate ?? '';
    const isRealDate = shootDate && !shootDate.startsWith('N/A') && shootDate !== 'To be confirmed';

    if (isRealDate) {
      const start = new Date(shootDate);
      if (!isNaN(start.getTime())) {
        const svc = serviceTitle.toLowerCase();
        let durMs = 2.5 * 60 * 60 * 1000;
        if (svc.includes('vacation') || svc.includes('str')) durMs = 4 * 60 * 60 * 1000;
        if (svc.includes('video'))    durMs = 2     * 60 * 60 * 1000;
        if (svc.includes('twilight')) durMs = 1     * 60 * 60 * 1000;

        const end = new Date(start.getTime() + durMs);
        const fmt = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z');

        // Google Calendar
        const gUrl = new URL('https://www.google.com/calendar/render');
        gUrl.searchParams.set('action', 'TEMPLATE');
        gUrl.searchParams.set('text', 'Photography Shoot – Ben Tims Media');
        gUrl.searchParams.set('dates', `${fmt(start)}/${fmt(end)}`);
        gUrl.searchParams.set('details', [serviceTitle, tierTitle, 'bentimsmedia.com'].filter(Boolean).join('\n'));
        if (address) gUrl.searchParams.set('location', address);
        gcalUrl = gUrl.toString();

        // ICS for Apple Calendar / Outlook
        const ics = [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//Ben Tims Media//Photography Booking//EN',
          'BEGIN:VEVENT',
          `DTSTART:${fmt(start)}`,
          `DTEND:${fmt(end)}`,
          'SUMMARY:Photography Shoot – Ben Tims Media',
          `DESCRIPTION:${[serviceTitle, tierTitle].filter(Boolean).join(' · ')}`,
          ...(address ? [`LOCATION:${address}`] : []),
          'END:VEVENT',
          'END:VCALENDAR',
        ].join('\r\n');

        icsDataUri = `data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}`;
      }
    }
  } catch {}
}

const showCal = !!(gcalUrl && icsDataUri);
const heroTitle = isPaidInFull ? 'Payment received!' : 'Deposit received!';
---
<BaseLayout
  title="Booking Confirmed"
  description="Your deposit was received. Ben Tims Media will be in touch shortly."
>
  <section class="mx-auto max-w-2xl px-5 py-20 sm:px-6 sm:py-32 text-center">
    <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-stone-100">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-stone-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </div>

    <p class="text-xs uppercase tracking-[0.25em] text-stone-400">You're booked</p>
    <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2rem,5vw,3rem)]">{heroTitle}</h1>
    <p class="mt-4 text-pretty text-stone-600">
      {isPaidInFull
        ? 'Your payment has been processed and your shoot date is confirmed.'
        : 'Your $150 deposit has been processed and your shoot date is held.'}
      {' '}I'll reach out within 24 hours to confirm the details and answer any questions.
    </p>

    {showCal && (
      <div class="mt-8">
        <p class="text-xs font-medium uppercase tracking-widest text-stone-400">Add to your calendar</p>
        <div class="mt-3 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <a
            href={gcalUrl!}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-stone-300 px-5 py-2.5 text-sm font-medium text-stone-700 transition hover:border-stone-400 hover:text-stone-900"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V9h14v11zM7 11h5v5H7z"/>
            </svg>
            Google Calendar
          </a>
          <a
            href={icsDataUri!}
            download="shoot-ben-tims-media.ics"
            class="inline-flex items-center gap-2 rounded-lg border border-stone-300 px-5 py-2.5 text-sm font-medium text-stone-700 transition hover:border-stone-400 hover:text-stone-900"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V9h14v11zM7 11h5v5H7z"/>
            </svg>
            Apple / Outlook
          </a>
        </div>
      </div>
    )}

    <p class="mt-8 text-sm text-stone-500">
      Questions? Reach me at{' '}
      {SITE.email && (
        <a href={`mailto:${SITE.email}`} class="underline underline-offset-2 hover:text-stone-800">
          {SITE.email}
        </a>
      )}
      {' '}or{' '}
      <a href="tel:5129565646" class="underline underline-offset-2 hover:text-stone-800">
        (512) 956-5646
      </a>
    </p>

    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a
        href="/"
        class="rounded-lg bg-stone-900 px-6 py-3 text-sm font-medium text-white transition hover:bg-stone-700"
      >
        Back to home
      </a>
      <a
        href="/portfolio/"
        class="rounded-lg border border-stone-300 px-6 py-3 text-sm font-medium text-stone-700 transition hover:border-stone-400 hover:text-stone-900"
      >
        View portfolio
      </a>
    </div>
  </section>
</BaseLayout>
