---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---
<BaseLayout
  title="Booking Confirmed"
  description="Your deposit was received. Ben Tims Media will be in touch shortly."
>
  <section class="mx-auto max-w-2xl px-5 py-20 sm:px-6 sm:py-32 text-center">
    <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-stone-100">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-stone-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </div>

    <p class="text-xs uppercase tracking-[0.25em] text-stone-400">You're booked</p>
    <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2rem,5vw,3rem)]">
      Deposit received!
    </h1>
    <p class="mt-4 text-pretty text-stone-600">
      Your $150 deposit has been processed and your shoot date is held.
      I'll reach out within 24 hours to confirm the details and answer any questions.
    </p>

    <p class="mt-3 text-sm text-stone-500">
      Questions? Reach me at{' '}
      {SITE.email && (
        <a href={`mailto:${SITE.email}`} class="underline underline-offset-2 hover:text-stone-800">
          {SITE.email}
        </a>
      )}
      {' '}or{' '}
      <a href="tel:5129565646" class="underline underline-offset-2 hover:text-stone-800">
        (512) 956-5646
      </a>
    </p>

    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a
        href="/"
        class="rounded-lg bg-stone-900 px-6 py-3 text-sm font-medium text-white transition hover:bg-stone-700"
      >
        Back to home
      </a>
      <a
        href="/portfolio/"
        class="rounded-lg border border-stone-300 px-6 py-3 text-sm font-medium text-stone-700 transition hover:border-stone-400 hover:text-stone-900"
      >
        View portfolio
      </a>
    </div>
  </section>
</BaseLayout>
