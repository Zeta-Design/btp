---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---
<BaseLayout
  title="Inquire"
  description={`Tell ${SITE.name} about your project and check availability for your date.`}
>
  <section class="mx-auto max-w-2xl px-6 py-16">
    <h1 class="font-serif text-4xl">Let's work together</h1>
    <p class="mt-3 text-stone-600">
      Share a few details and I'll be in touch within a day.
    </p>

    <div class="mt-10">
      {
        SITE.dubsadoFormUrl ? (
          // Dubsado lead-capture form. It handles the inquiry, then your Dubsado
          // workflow takes over: contract, invoice, payment — all tracked there.
          <iframe
            src={SITE.dubsadoFormUrl}
            title="Inquiry form"
            class="min-h-[720px] w-full rounded-md border border-stone-200"
            loading="lazy"
          />
        ) : (
          <div class="rounded-md border border-dashed border-stone-300 bg-white p-8 text-center text-stone-500">
            <p class="font-medium text-stone-700">Booking form goes here.</p>
            <p class="mt-2 text-sm">
              In Dubsado, open your lead-capture form → <em>Share</em>, copy the
              link, and paste it into <code>dubsadoFormUrl</code> in
              <code>src/config/site.ts</code>.
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
