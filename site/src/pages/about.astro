---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import portrait from '../assets/ben-tims.jpg';
---
<BaseLayout title="About" description={`Meet Ben — the real estate photographer behind ${SITE.name}.`}>
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="grid gap-10 sm:grid-cols-[2fr_3fr] sm:items-start">
      <Image
        src={portrait}
        alt={`Ben — ${SITE.name}`}
        widths={[400, 700]}
        sizes="(max-width: 640px) 100vw, 280px"
        class="w-full rounded-md object-cover"
      />
      <div>
        <p class="text-sm uppercase tracking-[0.2em] text-stone-500">About</p>
        <h1 class="mt-3 font-serif text-4xl leading-tight">Every frame tells a story</h1>
        <div class="prose-body mt-6 text-lg leading-relaxed text-stone-700">
          <p>
            Hi, I'm Ben — an Austin-based photographer with ties to the Denver metro
            area and a lifelong background in music and technology.
          </p>
          <p>
            I create real estate and short-term rental imagery that feels natural,
            polished, and purposeful — photographs that help a property feel like
            somewhere people want to be. Available to travel wherever the shot takes me.
          </p>
        </div>
        <a
          href="/contact/"
          class="mt-8 inline-block rounded-full bg-stone-900 px-7 py-3 text-sm text-stone-50 transition hover:bg-stone-700"
        >
          Work with me
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
