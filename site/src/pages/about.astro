---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import portrait from '../assets/ben-tims.jpg';
---
<BaseLayout title="About" description={`Meet Ben — the real estate photographer behind ${SITE.name}.`}>
  <section class="mx-auto max-w-5xl px-5 py-14 sm:px-6 sm:py-20">
    <div class="grid gap-10 sm:grid-cols-[2fr_3fr] sm:items-start sm:gap-14">
      <Image
        src={portrait}
        alt={`Ben — ${SITE.name}`}
        widths={[400, 700]}
        sizes="(max-width: 640px) 100vw, 320px"
        class="w-full rounded-lg object-cover"
      />
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-stone-400">About</p>
        <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2.25rem,6vw,3.5rem)]">
          Every frame tells a story
        </h1>
        <div class="prose-body mt-6 max-w-prose text-lg leading-relaxed text-stone-700">
          <p>
            Hi, I'm Ben — an Austin-based photographer with ties to the Denver metro
            area and a lifelong background in music and technology.
          </p>
          <p>
            I create real estate and short-term rental imagery that feels natural,
            polished, and purposeful — photographs that help a property feel like
            somewhere people want to be. Available to travel wherever the shot takes me.
          </p>
        </div>
        <a
          href="/contact/"
          class="mt-8 inline-flex min-h-[48px] items-center justify-center rounded-full bg-stone-900 px-7 text-sm font-medium text-stone-50 transition hover:bg-stone-700"
        >
          Work with me
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
