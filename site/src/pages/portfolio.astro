---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

// TEMPORARY placeholder photos (Lorem Picsum), varied heights for a natural
// masonry feel. Replace with real photos via astro:assets when ready (and add
// real, descriptive alt text — good for accessibility and image SEO).
const heights = [1000, 700, 1150, 850, 950, 1200, 800, 1050, 900, 1100, 750, 980];
const photos = heights.map((h, i) => ({
  src: `https://picsum.photos/seed/btm-p${i + 1}/800/${h}`,
  w: 800,
  h,
}));
---
<BaseLayout title="Portfolio" description={`A selection of recent work from ${SITE.name}.`}>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <h1 class="font-serif text-4xl">Portfolio</h1>
    <p class="mt-3 max-w-xl text-stone-400">A selection of recent work.</p>

    <div class="mt-10 columns-2 gap-4 sm:columns-3 [&>img]:mb-4">
      {
        photos.map((p) => (
          <img
            src={p.src}
            alt=""
            width={p.w}
            height={p.h}
            loading="lazy"
            class="w-full rounded-sm"
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
