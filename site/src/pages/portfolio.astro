---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

// TEMPORARY realty placeholder photos (LoremFlickr, keyword-based), varied
// heights for a natural masonry feel. Replace with real listing photos via
// astro:assets when ready (and add real, descriptive alt text for image SEO).
const items: [string, number, number][] = [
  ['interior', 41, 1000],
  ['kitchen', 42, 700],
  ['livingroom', 43, 1150],
  ['house', 44, 850],
  ['bedroom', 45, 950],
  ['bathroom', 46, 1200],
  ['architecture', 47, 800],
  ['apartment', 48, 1050],
  ['interior', 49, 900],
  ['kitchen', 50, 1100],
  ['house', 51, 750],
  ['livingroom', 52, 980],
];
const photos = items.map(([kw, lock, h]) => ({
  src: `https://loremflickr.com/800/${h}/${kw}?lock=${lock}`,
  w: 800,
  h,
}));
---
<BaseLayout title="Portfolio" description={`Real estate and short-term rental photography by ${SITE.name}.`}>
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20">
    <p class="text-xs uppercase tracking-[0.25em] text-stone-400">Portfolio</p>
    <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2.25rem,7vw,4rem)]">Recent work</h1>
    <p class="mt-4 max-w-xl text-pretty text-stone-600">
      Real estate and short-term rental work — interiors, exteriors, and the details
      that make a space feel like home.
    </p>

    <div class="mt-10 columns-1 gap-3 min-[420px]:columns-2 sm:columns-3 sm:gap-4 [&>*]:mb-3 sm:[&>*]:mb-4">
      {
        photos.map((p) => (
          <figure class="group block overflow-hidden">
            <img
              src={p.src}
              alt=""
              width={p.w}
              height={p.h}
              loading="lazy"
              class="w-full object-cover transition duration-500 group-hover:scale-[1.03]"
            />
          </figure>
        ))
      }
    </div>
  </section>
</BaseLayout>
