---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

// Auto-discovered + optimized (AVIF/WebP, responsive). To change the portfolio,
// just add/replace files in src/assets/portfolio/ — no code change needed.
const mods = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portfolio/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const photos = Object.keys(mods)
  .sort()
  .map((k) => mods[k].default);
---
<BaseLayout title="Portfolio" description={`Real estate and short-term rental photography by ${SITE.name}.`}>
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20">
    <p class="text-xs uppercase tracking-[0.25em] text-stone-400">Portfolio</p>
    <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2.25rem,7vw,4rem)]">Recent work</h1>
    <p class="mt-4 max-w-xl text-pretty text-stone-600">
      Real estate and short-term rental work — interiors, exteriors, and the details
      that make a space feel like home.
    </p>

    <div class="mt-10 columns-1 gap-3 min-[420px]:columns-2 sm:columns-3 sm:gap-4">
      {
        photos.map((img) => (
          <figure class="group mb-3 overflow-hidden sm:mb-4">
            <Image
              src={img}
              alt=""
              widths={[400, 800]}
              sizes="(max-width: 420px) 100vw, (max-width: 640px) 50vw, 33vw"
              format="webp"
              quality={74}
              loading="lazy"
              class="w-full object-cover transition duration-500 group-hover:scale-[1.03]"
            />
          </figure>
        ))
      }
    </div>
  </section>
</BaseLayout>
