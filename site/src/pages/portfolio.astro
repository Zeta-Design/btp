---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---
<BaseLayout
  title="Portfolio"
  description={`A selection of recent work from ${SITE.name}.`}
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <h1 class="font-serif text-4xl">Portfolio</h1>
    <p class="mt-3 max-w-xl text-stone-600">A selection of recent work.</p>

    <!--
      Add real photos with astro:assets so they're auto-optimized (AVIF/WebP,
      responsive sizes, lazy-loaded). Put files in src/assets/portfolio/ then:

        import { Image } from 'astro:assets';
        import img1 from '../assets/portfolio/01.jpg';
        <Image src={img1} alt="describe the photo" widths={[400,800,1200]}
               sizes="(max-width:640px) 50vw, 33vw" />

      Good alt text = better accessibility AND image SEO.
    -->
    <div class="mt-10 columns-2 gap-4 sm:columns-3 [&>*]:mb-4">
      {
        ['4/5', '3/4', '1/1', '4/5', '3/4', '1/1', '3/4', '4/5', '1/1'].map((ratio) => (
          <div class="rounded-sm bg-stone-200" style={`aspect-ratio:${ratio}`} />
        ))
      }
    </div>
  </section>
</BaseLayout>
