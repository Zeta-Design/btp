---
import { Image, Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

// Home "Selected work" shows the photos featured in /admin; falls back to the
// existing set until any are featured.
import { featured } from '../lib/gallery';
import { portfolio } from '../lib/portfolio';
const workEntries = (
  featured.length >= 6
    ? featured.map((p) => ({ meta: p.meta, alt: p.alt }))
    : portfolio.map((e) => ({ meta: e.meta, alt: e.alt }))
).slice(0, 9);
const work = workEntries.map((e) => e.meta);
const workAlts = workEntries.map((e) => e.alt);
const workFull = await Promise.all(
  work.map((m) => getImage({ src: m, format: 'webp', width: 1600 })),
);
const workFullUrls = workFull.map((f) => f.src);




// Hero: whatever src/assets/hero.* you drop in (any extension), with a fallback.
const heroMods = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero.{jpg,jpeg,png,webp}',
  { eager: true },
);
const hero = Object.values(heroMods)[0]?.default ?? portfolio[0]?.meta;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': Astro.site?.href,
  name: SITE.name,
  description: SITE.tagline,
  url: Astro.site?.href,
  ...(SITE.email && { email: SITE.email }),
  ...(SITE.location && {
    address: {
      '@type': 'PostalAddress',
      addressLocality: SITE.location.locality,
      addressRegion: SITE.location.region,
      postalCode: SITE.location.postalCode,
      addressCountry: SITE.location.country,
    },
  }),
  ...(SITE.areaServed && {
    areaServed: SITE.areaServed.map((name) => ({ '@type': 'City', name })),
  }),
  knowsAbout: [
    'Real estate photography',
    'Short-term rental photography',
    'Airbnb photography',
    'Architectural photography',
  ],
};

const services = [
  {
    title: 'Listing photography',
    body: 'Bright, true-to-life interiors and exteriors that make a property look its best and help it sell faster.',
  },
  {
    title: 'Short-term rentals',
    body: 'Airbnb and VRBO galleries that earn the click, styled, consistent, and built to stand out in search.',
  },
  {
    title: 'Walkthrough video',
    body: 'Smooth walkthrough video and social clips that bring a space to life beyond the stills.',
  },
];
---
<BaseLayout
  title="Real Estate & Airbnb Photographer in Austin, TX"
  description="Professional real estate, Airbnb & short-term rental photography in Austin, TX. Bright, magazine-quality listing photos and walkthrough video, delivered in 24–48 hours."
  jsonLd={jsonLd}
>
  <!-- Hero — LCP image: eager + high priority, AVIF/WebP via <Picture> -->
  <section class="relative isolate flex min-h-[88svh] items-center overflow-hidden bg-stone-900 py-24">
    <Picture
      src={hero}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 960, 1280]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="hero-img absolute inset-x-0 top-0 -z-10 h-full w-full object-cover object-center sm:-top-[32%] sm:h-[165%]"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/70 via-black/50 to-black/75"></div>
    <div class="mx-auto w-full max-w-6xl px-5 sm:px-6">
      <div class="max-w-3xl text-center text-white sm:text-left">
        <p class="text-xs uppercase tracking-[0.3em] text-white/80 sm:text-sm">
          Real estate photography · Austin based
        </p>
        <h1 class="mt-5 font-serif font-medium leading-[0.95] tracking-tight text-[clamp(2.75rem,9vw,6rem)]">
          Spaces that sell themselves.
        </h1>
        <p class="mx-auto mt-6 max-w-lg text-pretty text-base text-white/85 sm:mx-0 sm:text-lg">
          Real estate and short-term rental photography. Interiors, exteriors, and walkthrough videos.
        </p>
        <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row sm:items-center">
          <a
            href="/portfolio/"
            class="inline-flex min-h-[48px] w-full max-w-xs items-center justify-center rounded-full bg-white px-7 text-sm font-medium text-stone-900 transition hover:bg-stone-200 sm:w-auto sm:max-w-none"
          >
            View work
          </a>
          <a
            href="/contact/"
            class="inline-flex min-h-[48px] w-full max-w-xs items-center justify-center rounded-full border border-white/60 px-7 text-sm text-white transition hover:bg-white/10 sm:w-auto sm:max-w-none"
          >
            Book a session
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28">
    <div class="max-w-3xl">
      <p class="text-xs uppercase tracking-[0.25em] text-stone-500">What I offer</p>
      <h2 class="mt-3 text-balance font-serif leading-[1.05] text-[clamp(1.9rem,5vw,3rem)]">
        Photography that makes a property impossible to scroll past.
      </h2>
    </div>
    <div class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        services.map((s, i) => (
          <div class="border-t border-stone-200 pt-5">
            <span class="font-serif text-sm text-stone-500">0{i + 1}</span>
            <h3 class="mt-2 font-serif text-xl">{s.title}</h3>
            <p class="mt-2 text-balance text-stone-600">{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Selected work -->
  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-6 sm:pb-28">
    <div class="flex items-end justify-between">
      <h2 class="font-serif text-[clamp(1.9rem,5vw,3rem)]">Recent work</h2>
      <a href="/portfolio/" class="hidden text-sm text-stone-500 transition hover:text-stone-900 sm:inline">
        View all →
      </a>
    </div>
    <div id="sw-gallery" class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
      {
        work.map((img, i) => (
          <button
            type="button"
            data-i={i}
            aria-label={`View image ${i + 1} larger`}
            class="sw-card group relative block aspect-[4/3] w-full animate-pulse overflow-hidden rounded-sm bg-stone-200 shadow-sm transition duration-300 hover:-translate-y-3 hover:shadow-lg cursor-pointer"
          >
            <Image
              src={img}
              alt={workAlts[i]}
              widths={[400, 800]}
              sizes="(max-width: 640px) 50vw, 33vw"
              format="webp"
              quality={72}
              loading="lazy"
              class="sw-img h-full w-full object-cover opacity-0 transition-opacity duration-700"
            />
          </button>
        ))
      }
    </div>

    <div class="mt-10 flex justify-center">
      <a href="/portfolio/" class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-stone-300 px-8 text-sm font-medium text-stone-700 transition hover:border-stone-900 hover:text-stone-900">
        View all work
      </a>
    </div>
    <a href="/portfolio/" class="mt-8 inline-flex text-sm text-stone-500 transition hover:text-stone-900 sm:hidden">
      View all →
    </a>
  </section>

  <!-- Lightbox (selected work) -->
  <div
    id="sw-lightbox"
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="Image viewer"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 p-4"
  >
    <button data-close aria-label="Close" class="absolute right-3 top-3 inline-flex h-11 w-11 items-center justify-center rounded-full text-2xl text-white/90 hover:bg-white/10">×</button>
    <button data-prev aria-label="Previous" class="absolute left-2 inline-flex h-12 w-12 items-center justify-center rounded-full text-3xl text-white/90 hover:bg-white/10 sm:left-5">‹</button>
    <img id="sw-lb-img" alt="" class="max-h-[88vh] max-w-[92vw] object-contain" />
    <button data-next aria-label="Next" class="absolute right-2 inline-flex h-12 w-12 items-center justify-center rounded-full text-3xl text-white/90 hover:bg-white/10 sm:right-5">›</button>
    <a href="/portfolio/" data-viewall aria-label="View all photos" class="absolute bottom-5 left-1/2 -translate-x-1/2 rounded-full bg-white/10 px-5 py-2 text-sm text-white/90 transition hover:bg-white/20">
      View all →
    </a>
  </div>

  <script type="application/json" id="sw-full" set:html={JSON.stringify(workFullUrls)}></script>
  <script type="application/json" id="sw-alts" set:html={JSON.stringify(workAlts)}></script>
  <script>
    const swFulls: string[] = JSON.parse(document.getElementById('sw-full')?.textContent || '[]');
    const swAlts: string[] = JSON.parse(document.getElementById('sw-alts')?.textContent || '[]');
    const swLb = document.getElementById('sw-lightbox') as HTMLElement;
    const swImg = document.getElementById('sw-lb-img') as HTMLImageElement;
    let swIdx = 0;

    const swShow = (i: number) => {
      swIdx = (i + swFulls.length) % swFulls.length;
      swImg.src = swFulls[swIdx];
      swImg.alt = swAlts[swIdx] || '';
    };
    const swOpen = (i: number) => {
      swShow(i);
      swLb.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const swClose = () => {
      swLb.hidden = true;
      swImg.removeAttribute('src');
      document.body.style.overflow = '';
    };

    document.querySelectorAll<HTMLButtonElement>('#sw-gallery [data-i]').forEach((btn) =>
      btn.addEventListener('click', () => swOpen(Number(btn.dataset.i))),
    );

    // Skeleton: reveal cards one by one when gallery scrolls into view
    const swCards = Array.from(document.querySelectorAll<HTMLElement>('#sw-gallery .sw-card'));
    const swImgs  = swCards.map(c => c.querySelector<HTMLImageElement>('.sw-img')!);

    const revealCard = (card: HTMLElement, img: HTMLImageElement) => {
      card.classList.remove('animate-pulse', 'bg-stone-200');
      img.classList.remove('opacity-0');
      img.classList.add('opacity-100');
    };

    const galleryObserver = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      galleryObserver.disconnect();
      swCards.forEach((card, i) => {
        const img = swImgs[i];
        setTimeout(() => {
          if (img.complete && img.naturalWidth > 0) revealCard(card, img);
          else img.addEventListener('load', () => revealCard(card, img), { once: true });
        }, i * 150);
      });
    }, { threshold: 0.1 });

    const swGalleryEl = document.getElementById('sw-gallery');
    if (swGalleryEl) galleryObserver.observe(swGalleryEl);
    swLb.querySelector('[data-close]')!.addEventListener('click', swClose);
    swLb.querySelector('[data-prev]')!.addEventListener('click', () => swShow(swIdx - 1));
    swLb.querySelector('[data-next]')!.addEventListener('click', () => swShow(swIdx + 1));
    swLb.addEventListener('click', (e) => { if (e.target === swLb) swClose(); });
    document.addEventListener('keydown', (e) => {
      if (swLb.hidden) return;
      if (e.key === 'Escape') swClose();
      else if (e.key === 'ArrowLeft') swShow(swIdx - 1);
      else if (e.key === 'ArrowRight') swShow(swIdx + 1);
    });
    let swSx = 0;
    swLb.addEventListener('touchstart', (e) => (swSx = e.changedTouches[0].clientX), { passive: true });
    swLb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - swSx;
      if (Math.abs(dx) > 50) swShow(swIdx + (dx < 0 ? 1 : -1));
    }, { passive: true });
  </script>

<style is:inline>
  /* Hero parallax — pure CSS scroll-driven animation (compositor thread, no JS,
     no jank). Progressive enhancement: only runs where supported and when the
     user hasn't asked for reduced motion; otherwise the hero is simply static.
     is:inline so Astro's CSS minifier doesn't prune `animation-timeline: scroll()`. */
  @keyframes hero-parallax {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, 30%, 0);
    }
  }
  @media (min-width: 640px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero-img {
        will-change: transform;
        animation: hero-parallax linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 100vh;
      }
    }
  }
</style>
</BaseLayout>
