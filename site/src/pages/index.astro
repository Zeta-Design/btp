---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  description: SITE.tagline,
  url: Astro.site?.href,
  ...(SITE.email && { email: SITE.email }),
  areaServed: 'Austin, TX',
};

// TEMPORARY realty placeholder photos (LoremFlickr, keyword-based, locked for
// stable results). Swap for Ben's real listing photos via astro:assets later.
const flickr = (kw: string, lock: number, w = 800, h = 1000) =>
  `https://loremflickr.com/${w}/${h}/${kw}?lock=${lock}`;

const work = [
  flickr('interior', 31),
  flickr('kitchen', 32),
  flickr('livingroom', 33),
  flickr('bedroom', 34),
  flickr('bathroom', 35),
  flickr('house', 36),
];

const services = [
  {
    title: 'Listing photography',
    body: "Bright, true-to-life interiors and exteriors that make a property look its best and help it sell faster.",
  },
  {
    title: 'Short-term rentals',
    body: 'Airbnb and VRBO galleries that earn the click — styled, consistent, and built to stand out in search.',
  },
  {
    title: 'Walkthrough video',
    body: 'Smooth gimbal walkthrough video and social clips that bring a space to life beyond the stills.',
  },
];
---
<BaseLayout title={SITE.name} description={SITE.tagline} jsonLd={jsonLd}>
  <section class="relative isolate flex min-h-[78vh] items-center justify-center overflow-hidden">
    <img
      src={flickr('house,architecture', 20, 1920, 1080)}
      alt=""
      width="1920"
      height="1080"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-black/45"></div>
    <div class="max-w-2xl px-6 text-center text-white">
      <p class="text-sm uppercase tracking-[0.25em] text-white/80">Real estate photography</p>
      <h1 class="mt-4 font-serif text-5xl leading-tight sm:text-6xl">Spaces that sell themselves.</h1>
      <p class="mx-auto mt-6 max-w-md text-lg text-white/85">
        {SITE.name} — real estate and short-term rental photography in Austin.
        Interiors, exteriors, and gimbal walkthrough video.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/portfolio/"
          class="inline-block rounded-full bg-white px-7 py-3 text-sm text-stone-900 transition hover:bg-stone-200"
        >
          View work
        </a>
        <a
          href="/contact/"
          class="inline-block rounded-full border border-white/70 px-7 py-3 text-sm text-white transition hover:bg-white/10"
        >
          Book a session
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="font-serif text-3xl">What I offer</h2>
    <div class="mt-8 grid gap-8 sm:grid-cols-3">
      {
        services.map((s) => (
          <div>
            <h3 class="font-serif text-xl">{s.title}</h3>
            <p class="mt-2 text-stone-600">{s.body}</p>
          </div>
        ))
      }
    </div>
    <a href="/contact/" class="mt-8 inline-block text-sm text-stone-500 hover:text-stone-900">
      See pricing &amp; book a session →
    </a>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div class="flex items-end justify-between">
      <h2 class="font-serif text-3xl">Selected work</h2>
      <a href="/portfolio/" class="text-sm text-stone-500 hover:text-stone-900">View portfolio →</a>
    </div>
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
      {
        work.map((src) => (
          <img
            src={src}
            alt=""
            width="800"
            height="1000"
            loading="lazy"
            class="aspect-[4/5] w-full rounded-sm object-cover"
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
