---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

// Gallery images are auto-discovered from src/assets/portfolio/ and optimized by
// astro:assets (AVIF/WebP, responsive srcset). Drop in real photos and they just
// work — no code change needed.
const galleryMods = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portfolio/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const gallery = Object.keys(galleryMods)
  .sort()
  .map((k) => galleryMods[k].default);
const work = gallery.slice(0, 6);

// Hero: whatever src/assets/hero.* you drop in (any extension), with a fallback.
const heroMods = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero.{jpg,jpeg,png,webp}',
  { eager: true },
);
const hero = Object.values(heroMods)[0]?.default ?? gallery[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': Astro.site?.href,
  name: SITE.name,
  description: SITE.tagline,
  url: Astro.site?.href,
  ...(SITE.email && { email: SITE.email }),
  ...(SITE.location && {
    address: {
      '@type': 'PostalAddress',
      addressLocality: SITE.location.locality,
      addressRegion: SITE.location.region,
      postalCode: SITE.location.postalCode,
      addressCountry: SITE.location.country,
    },
  }),
  ...(SITE.areaServed && {
    areaServed: SITE.areaServed.map((name) => ({ '@type': 'City', name })),
  }),
  knowsAbout: [
    'Real estate photography',
    'Short-term rental photography',
    'Airbnb photography',
    'Architectural photography',
  ],
};

const services = [
  {
    title: 'Listing photography',
    body: 'Bright, true-to-life interiors and exteriors that make a property look its best and help it sell faster.',
  },
  {
    title: 'Short-term rentals',
    body: 'Airbnb and VRBO galleries that earn the click — styled, consistent, and built to stand out in search.',
  },
  {
    title: 'Walkthrough video',
    body: 'Smooth gimbal walkthrough video and social clips that bring a space to life beyond the stills.',
  },
];
---
<BaseLayout title={SITE.name} description={SITE.tagline} jsonLd={jsonLd}>
  <!-- Hero — LCP image: eager + high priority, AVIF/WebP via <Picture> -->
  <section
    class="hero relative isolate flex min-h-[88svh] items-center overflow-hidden py-24"
    data-hero
  >
    <!-- Image sits taller than the section so it has room to drift on scroll -->
    <Picture
      src={hero}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 960, 1280]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="hero-img absolute inset-x-0 -top-[15%] -z-20 h-[130%] w-full object-cover"
      data-hero-img
    />
    <!-- Scrim: a soft, bottom-weighted base for overall contrast… -->
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/65 via-black/25 to-black/35"></div>
    <!-- …and a focused pool of shade behind the text so the rest of the photo stays bright -->
    <div class="hero-scrim absolute inset-0 -z-10"></div>
    <div class="mx-auto w-full max-w-6xl px-5 sm:px-6">
      <div class="hero-content max-w-3xl text-center text-white sm:text-left" data-hero-content>
        <p class="text-xs uppercase tracking-[0.3em] text-white/80 sm:text-sm">
          Real estate photography<span class="hidden sm:inline"> · </span><br class="sm:hidden" />Greater Austin
        </p>
        <h1 class="mt-5 font-serif font-medium leading-[0.95] tracking-tight text-[clamp(2.75rem,9vw,6rem)]">
          Spaces that sell themselves.
        </h1>
        <p class="mx-auto mt-6 max-w-lg text-pretty text-base text-white/85 sm:mx-0 sm:text-lg">
          Real estate and short-term rental photography. Interiors, exteriors, and
          gimbal walkthrough video.
        </p>
        <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row sm:items-center">
          <a
            href="/portfolio/"
            class="inline-flex min-h-[48px] w-full max-w-xs items-center justify-center rounded-full bg-white px-7 text-sm font-medium text-stone-900 transition hover:bg-stone-200 sm:w-auto sm:max-w-none"
          >
            View work
          </a>
          <a
            href="/contact/"
            class="inline-flex min-h-[48px] w-full max-w-xs items-center justify-center rounded-full border border-white/60 px-7 text-sm text-white transition hover:bg-white/10 sm:w-auto sm:max-w-none"
          >
            Book a session
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28">
    <div class="max-w-2xl">
      <p class="text-xs uppercase tracking-[0.25em] text-stone-400">What I offer</p>
      <h2 class="mt-3 font-serif leading-[1.05] text-[clamp(1.9rem,5vw,3rem)]">
        Photography that makes a property impossible to scroll past.
      </h2>
    </div>
    <div class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        services.map((s, i) => (
          <div class="border-t border-stone-200 pt-5">
            <span class="font-serif text-sm text-stone-400">0{i + 1}</span>
            <h3 class="mt-2 font-serif text-xl">{s.title}</h3>
            <p class="mt-2 text-balance text-stone-600">{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Selected work -->
  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-6 sm:pb-28">
    <div class="flex items-end justify-between">
      <h2 class="font-serif text-[clamp(1.9rem,5vw,3rem)]">Selected work</h2>
      <a href="/portfolio/" class="hidden text-sm text-stone-500 transition hover:text-stone-900 sm:inline">
        View all →
      </a>
    </div>
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
      {
        work.map((img) => (
          <a href="/portfolio/" class="group block overflow-hidden" aria-label="View portfolio">
            <Image
              src={img}
              alt=""
              widths={[300, 600]}
              sizes="(max-width: 640px) 50vw, 33vw"
              format="webp"
              quality={72}
              loading="lazy"
              class="aspect-[4/5] w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </a>
        ))
      }
    </div>
    <a href="/portfolio/" class="mt-8 inline-flex text-sm text-stone-500 transition hover:text-stone-900 sm:hidden">
      View all →
    </a>
  </section>
</BaseLayout>

<style>
  /* Focused scrim behind the hero text. On mobile the copy is centred, so the
     pool of shade is centred; on wider screens the copy sits left, so it shifts
     to follow. The photo stays bright everywhere the text isn't. */
  .hero-scrim {
    background: radial-gradient(
      120% 85% at 50% 48%,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.18) 46%,
      transparent 74%
    );
  }

  @media (min-width: 640px) {
    .hero-scrim {
      background: radial-gradient(
        72% 95% at 24% 50%,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0.18) 46%,
        transparent 72%
      );
    }
  }

  /* The JS below drives these transforms; declaring will-change keeps the
     compositor warm. Both layers fall back to a clean static state with no JS
     or when the visitor prefers reduced motion. */
  .hero-img,
  .hero-content {
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-img,
    .hero-content {
      transform: none !important;
      opacity: 1 !important;
      will-change: auto;
    }
  }
</style>

<script>
  // Lightweight scroll parallax: the photo drifts down slowly while the copy
  // lifts and fades, so the two layers separate as you scroll and never fight
  // for attention. rAF-throttled and reduced-motion aware.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const img = document.querySelector<HTMLElement>('[data-hero-img]');
  const content = document.querySelector<HTMLElement>('[data-hero-content]');

  if (hero && img && content && !reduce.matches) {
    let ticking = false;

    const update = () => {
      // 0 while the hero fills the viewport, → 1 as it scrolls fully away.
      const top = hero.getBoundingClientRect().top;
      const p = Math.min(Math.max(-top / window.innerHeight, 0), 1);

      // Photo drifts down a touch slower than the page (stays fully covered by
      // the 130%-tall image) and eases in a gentle zoom.
      img.style.transform = `translate3d(0, ${p * 12}%, 0) scale(${1 + p * 0.06})`;
      // Copy lifts away and softens so it clears the frame cleanly.
      content.style.transform = `translate3d(0, ${p * -28}px, 0)`;
      content.style.opacity = `${1 - p * 0.6}`;

      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
