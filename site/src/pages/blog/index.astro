---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
<BaseLayout
  title="Journal"
  description={`Stories, guides, and recent work from ${SITE.name}.`}
>
  <section class="mx-auto max-w-2xl px-6 py-16">
    <h1 class="font-serif text-4xl">Journal</h1>
    <p class="mt-3 text-stone-600">Stories, guides, and recent work.</p>

    <ul class="mt-10 divide-y divide-stone-200">
      {
        posts.map((post) => (
          <li class="py-6">
            <a href={`/blog/${post.id}/`} class="group block">
              <h2 class="font-serif text-2xl transition group-hover:text-stone-500">
                {post.data.title}
              </h2>
              <p class="mt-2 text-stone-600">{post.data.description}</p>
              <time
                datetime={post.data.pubDate.toISOString()}
                class="mt-2 block text-sm text-stone-400"
              >
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
