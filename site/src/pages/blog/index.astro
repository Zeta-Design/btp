---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
<BaseLayout title="Blog" description={`Stories, guides, and recent work from ${SITE.name}.`}>
  <section class="mx-auto max-w-2xl px-5 py-14 sm:px-6 sm:py-20">
    <p class="text-xs uppercase tracking-[0.25em] text-stone-400">Blog</p>
    <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2.25rem,6vw,3.5rem)]">Notes &amp; guides</h1>
    <p class="mt-4 text-stone-600">Stories, guides, and recent work.</p>

    <ul class="mt-10 divide-y divide-stone-200">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="group flex flex-col py-6">
              <h2 class="font-serif text-2xl transition group-hover:text-stone-500">
                {post.data.title}
              </h2>
              <p class="mt-2 text-stone-600">{post.data.description}</p>
              <time
                datetime={post.data.pubDate.toISOString()}
                class="mt-2 text-sm text-stone-400"
              >
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
