---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---
<BaseLayout
  title="Contact"
  description={`Tell ${SITE.name} about your property or listing and check availability.`}
>
  <section class="mx-auto max-w-2xl px-5 py-14 sm:px-6 sm:py-20">
    <p class="text-xs uppercase tracking-[0.25em] text-stone-400">Get in touch</p>
    <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2.25rem,6vw,3.5rem)]">
      Let's make your listing shine
    </h1>
    <p class="mt-4 text-pretty text-stone-600">
      Whether you have a specific listing in mind or are just exploring, I'd love to
      hear from you. Inquiries are typically answered within 24 hours.
    </p>

    <div class="mt-10">
      {
        SITE.dubsadoFormUrl ? (
          // Dubsado lead-capture form, embedded with iframe-resizer so it
          // auto-sizes to the form's height (no inner scrollbar).
          <iframe
            id="dubsado-form"
            src={`${SITE.dubsadoFormUrl}?iframe=true`}
            title="Inquiry form"
            frameborder="0"
            width="100%"
            height="750"
            loading="lazy"
            class="w-full rounded-lg border border-stone-200"
          />
        ) : (
          <div class="rounded-lg border border-dashed border-stone-300 bg-white p-8 text-center text-stone-500">
            <p class="font-medium text-stone-700">Booking form goes here.</p>
            <p class="mt-2 text-sm">
              Paste your Dubsado lead-capture link into <code>dubsadoFormUrl</code> in
              <code>src/config/site.ts</code>.
            </p>
          </div>
        )
      }
    </div>
  </section>

  {
    SITE.dubsadoFormUrl && (
      <>
        <script
          is:inline
          src="https://cdnjs.cloudflare.com/ajax/libs/iframe-resizer/3.5.14/iframeResizer.min.js"
        />
        <script is:inline>
          (function () {
            function init() {
              if (window.iFrameResize) {
                window.iFrameResize({ checkOrigin: false }, '#dubsado-form');
              } else {
                setTimeout(init, 100);
              }
            }
            setTimeout(init, 30);
          })();
        </script>
      </>
    )
  }
</BaseLayout>
