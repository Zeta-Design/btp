---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---
<BaseLayout
  title="Contact"
  description={`Tell ${SITE.name} about your property or listing and check availability.`}
>
  <section class="mx-auto max-w-2xl px-6 py-16">
    <p class="text-sm uppercase tracking-[0.2em] text-stone-500">Get in touch</p>
    <h1 class="mt-3 font-serif text-4xl">Let's make your listing shine</h1>
    <p class="mt-3 text-stone-600">
      Whether you have a specific listing in mind or are just exploring, I'd love to
      hear from you. Inquiries are typically answered within 24 hours.
    </p>

    <div class="mt-10">
      {
        SITE.dubsadoFormUrl ? (
          // Dubsado lead-capture form. It handles the inquiry, quote, and booking;
          // your Dubsado workflow then takes over contract → invoice → payment.
          <iframe
            src={SITE.dubsadoFormUrl}
            title="Inquiry form"
            class="min-h-[720px] w-full rounded-md border border-stone-200"
            loading="lazy"
          />
        ) : (
          <div class="rounded-md border border-dashed border-stone-300 bg-white p-8 text-center text-stone-500">
            <p class="font-medium text-stone-700">Booking form goes here.</p>
            <p class="mt-2 text-sm">
              Paste your Dubsado lead-capture link into <code>dubsadoFormUrl</code> in
              <code>src/config/site.ts</code>.
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
