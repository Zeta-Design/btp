---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const sent = Astro.url.searchParams.get('sent') === '1';
export const prerender = false;
---
<BaseLayout
  title="Contact"
  description={`Tell ${SITE.name} about your property or listing and check availability.`}
>
  <section class="mx-auto max-w-2xl px-5 py-14 sm:px-6 sm:py-20">
    <p class="text-xs uppercase tracking-[0.25em] text-stone-400">Get in touch</p>
    <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2.25rem,6vw,3.5rem)]">
      Let's make your listing shine
    </h1>
    <p class="mt-4 text-pretty text-stone-600">
      Whether you have a specific listing in mind or are just exploring, I'd love to
      hear from you. Inquiries are typically answered within 24 hours.
    </p>

    {sent ? (
      <div class="mt-10 rounded-xl border border-stone-200 bg-stone-50 px-8 py-12 text-center">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-stone-900">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </div>
        <h2 class="font-serif text-2xl">Message received</h2>
        <p class="mt-3 text-stone-600">Thanks for reaching out — I'll get back to you within 24 hours.</p>
        <a href="/" class="mt-6 inline-flex items-center rounded-full bg-stone-900 px-6 py-2.5 text-sm font-medium text-white transition hover:bg-stone-700">Back to home</a>
      </div>
    ) : (
      <form method="POST" action="/api/contact" class="mt-10 space-y-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="mb-1.5 block text-sm font-medium text-stone-700">Name <span class="text-stone-400">*</span></label>
            <input
              id="name" name="name" type="text" required autocomplete="name"
              class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
              placeholder="Jane Smith"
            />
          </div>
          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium text-stone-700">Email <span class="text-stone-400">*</span></label>
            <input
              id="email" name="email" type="email" required autocomplete="email"
              class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
              placeholder="jane@example.com"
            />
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="phone" class="mb-1.5 block text-sm font-medium text-stone-700">Phone <span class="text-stone-400 font-normal">(optional)</span></label>
            <input
              id="phone" name="phone" type="tel" autocomplete="tel"
              class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
              placeholder="(512) 555-0100"
            />
          </div>
          <div>
            <label for="service" class="mb-1.5 block text-sm font-medium text-stone-700">Service interested in</label>
            <select
              id="service" name="service"
              class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 transition focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
            >
              <option value="">Not sure yet</option>
              <option value="Real Estate Photography">Real Estate Photography</option>
              <option value="Vacation Rental Photography">Vacation Rental Photography</option>
              <option value="Walkthrough Video">Walkthrough Video</option>
              <option value="Twilight Session">Twilight Session</option>
              <option value="Virtual Twilight Edit">Virtual Twilight Edit</option>
            </select>
          </div>
        </div>

        <div>
          <label for="message" class="mb-1.5 block text-sm font-medium text-stone-700">Message <span class="text-stone-400">*</span></label>
          <textarea
            id="message" name="message" required rows="5"
            class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
            placeholder="Tell me about your property, preferred dates, or anything else on your mind…"
          ></textarea>
        </div>

        <button
          type="submit"
          class="inline-flex min-h-[48px] w-full items-center justify-center rounded-full bg-stone-900 px-8 text-sm font-medium text-white transition hover:bg-stone-700 sm:w-auto"
        >
          Send message
        </button>
      </form>
    )}
  </section>
</BaseLayout>
