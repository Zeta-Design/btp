---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Reuse the same portfolio photos, optimized to webp via astro:assets.
// Smaller width here (wall art) = faster texture loads.
const mods = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portfolio/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const metas = Object.keys(mods)
  .sort()
  .map((k) => mods[k].default);
const images = await Promise.all(
  metas.map(async (m) => {
    const img = await getImage({ src: m, format: 'webp', width: 800 });
    return { src: img.src, ratio: m.width / m.height };
  }),
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>3D Gallery (experiment) · Ben Tims Media</title>
    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; background: #141416; overflow: hidden; }
      body {
        font-family: ui-sans-serif, -apple-system, system-ui, sans-serif;
        color: #fff; -webkit-font-smoothing: antialiased;
      }
      #app { position: fixed; inset: 0; }
      canvas { display: block; }

      /* Minimal back control */
      #back {
        position: fixed; top: max(14px, env(safe-area-inset-top)); left: 14px; z-index: 30;
        display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 14px;
        font-size: 13px; color: #fff; text-decoration: none;
        background: rgba(0,0,0,.4); border: 1px solid rgba(255,255,255,.18);
        border-radius: 999px; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
      }
      #back:active { background: rgba(0,0,0,.65); }

      #crosshair {
        position: fixed; top: 50%; left: 50%; width: 6px; height: 6px; margin: -3px 0 0 -3px;
        border-radius: 50%; background: rgba(255,255,255,.85); z-index: 10; pointer-events: none; display: none;
      }

      /* Loading + start share one centered, uncluttered layer */
      .layer {
        position: fixed; inset: 0; z-index: 20; display: grid; place-items: center;
        background: rgba(20,20,22,.9); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
        padding: 24px; text-align: center; transition: opacity .4s ease;
      }
      .layer[hidden] { display: none; }
      .spinner {
        width: 34px; height: 34px; border-radius: 50%;
        border: 2px solid rgba(255,255,255,.18); border-top-color: #fff;
        animation: spin .8s linear infinite; margin: 0 auto 16px;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) { .spinner { animation-duration: 2s; } }
      #loading p { margin: 0 0 12px; font-size: 15px; color: rgba(255,255,255,.85); font-variant-numeric: tabular-nums; }
      .bar { height: 3px; width: 100%; background: rgba(255,255,255,.16); border-radius: 999px; overflow: hidden; }
      #bar-fill { height: 100%; width: 0; background: #fff; transition: width .25s ease; }

      #start .enter {
        appearance: none; min-height: 50px; padding: 0 30px; font-size: 15px; font-weight: 500;
        color: #141416; background: #fff; border: 0; border-radius: 999px; cursor: pointer;
      }
      #start .enter:active { background: #d8d8d8; }
      #start .hint { margin: 16px 0 0; font-size: 12.5px; line-height: 1.5; color: rgba(255,255,255,.55); }

      /* Mobile drag hint — auto-fades */
      #touchhint {
        position: fixed; left: 50%; bottom: max(22px, env(safe-area-inset-bottom)); transform: translateX(-50%);
        z-index: 15; font-size: 13px; color: #fff; padding: 9px 16px; border-radius: 999px;
        background: rgba(0,0,0,.45); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
        transition: opacity .6s ease; pointer-events: none;
      }
      #touchhint[hidden] { display: none; }
    </style>
  </head>
  <body>
    <a id="back" href="/">← Back</a>
    <div id="app"></div>
    <div id="crosshair"></div>

    <div id="loading" class="layer">
      <div style="width: min(78vw, 260px)">
        <p id="loading-text">Loading 0%</p>
        <div class="bar"><div id="bar-fill"></div></div>
      </div>
    </div>

    <div id="start" class="layer" hidden>
      <div>
        <button class="enter" type="button">Enter gallery</button>
        <p class="hint">WASD to move · mouse to look · Esc to exit</p>
      </div>
    </div>

    <div id="touchhint" hidden>Drag to explore</div>

    <script type="application/json" id="gallery-images" set:html={JSON.stringify(images)}></script>

    <script>
      import * as THREE from 'three';
      import { PointerLockControls } from 'three/addons/controls/PointerLockControls.js';
      import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

      type Img = { src: string; ratio: number };
      const images: Img[] = JSON.parse(
        document.getElementById('gallery-images')?.textContent || '[]',
      );

      const isTouch = window.matchMedia('(pointer: coarse)').matches;
      const app = document.getElementById('app')!;
      const loadingEl = document.getElementById('loading')!;
      const loadingText = document.getElementById('loading-text')!;
      const barFill = document.getElementById('bar-fill') as HTMLElement;
      const startEl = document.getElementById('start')!;
      const touchHint = document.getElementById('touchhint')!;
      const crosshair = document.getElementById('crosshair')!;

      const fadeOut = (el: HTMLElement) => {
        el.style.opacity = '0';
        setTimeout(() => (el.hidden = true), 420);
      };

      // ---- Scene ----
      const HALL_W = 9;
      const WALL_H = 3.6;
      const SPACING = 5;
      const EYE = 1.65;
      const rows = Math.max(1, Math.ceil(images.length / 2));
      const HALL_LEN = rows * SPACING + SPACING;
      const midZ = -HALL_LEN / 2 + SPACING / 2;

      const scene = new THREE.Scene();
      scene.background = new THREE.Color('#141416');
      scene.fog = new THREE.Fog('#141416', 14, HALL_LEN + 14);

      const camera = new THREE.PerspectiveCamera(70, innerWidth / innerHeight, 0.1, 200);
      camera.position.set(0, EYE, SPACING - 1);
      scene.add(camera);

      let renderer: THREE.WebGLRenderer;
      try {
        renderer = new THREE.WebGLRenderer({ antialias: true });
      } catch (err) {
        document.querySelector('#loading .spinner')?.remove();
        loadingText.textContent = "This browser couldn't start 3D (WebGL).";
        throw err;
      }
      renderer.setSize(innerWidth, innerHeight);
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      app.appendChild(renderer.domElement);

      scene.add(new THREE.HemisphereLight('#ffffff', '#3a3a40', 1.1));
      scene.add(new THREE.AmbientLight('#ffffff', 0.4));
      const key = new THREE.DirectionalLight('#ffffff', 0.5);
      key.position.set(3, 8, 4);
      scene.add(key);

      // ---- Room ----
      const floorMat = new THREE.MeshStandardMaterial({ color: '#2a2a2e', roughness: 0.9 });
      const wallMat = new THREE.MeshStandardMaterial({ color: '#1c1c1f', roughness: 1 });
      const floor = new THREE.Mesh(new THREE.PlaneGeometry(HALL_W, HALL_LEN + SPACING), floorMat);
      floor.rotation.x = -Math.PI / 2; floor.position.z = midZ; scene.add(floor);
      const ceil = new THREE.Mesh(new THREE.PlaneGeometry(HALL_W, HALL_LEN + SPACING), wallMat);
      ceil.rotation.x = Math.PI / 2; ceil.position.set(0, WALL_H, midZ); scene.add(ceil);
      const sideGeo = new THREE.PlaneGeometry(HALL_LEN + SPACING, WALL_H);
      const left = new THREE.Mesh(sideGeo, wallMat);
      left.rotation.y = Math.PI / 2; left.position.set(-HALL_W / 2, WALL_H / 2, midZ); scene.add(left);
      const right = new THREE.Mesh(sideGeo, wallMat);
      right.rotation.y = -Math.PI / 2; right.position.set(HALL_W / 2, WALL_H / 2, midZ); scene.add(right);
      const endGeo = new THREE.PlaneGeometry(HALL_W, WALL_H);
      const front = new THREE.Mesh(endGeo, wallMat);
      front.position.set(0, WALL_H / 2, SPACING); front.rotation.y = Math.PI; scene.add(front);
      const back = new THREE.Mesh(endGeo, wallMat);
      back.position.set(0, WALL_H / 2, -HALL_LEN); scene.add(back);

      // ---- Artwork (tracked by a LoadingManager for real progress) ----
      const manager = new THREE.LoadingManager();
      const loader = new THREE.TextureLoader(manager);
      const frameMat = new THREE.MeshStandardMaterial({ color: '#0a0a0b', roughness: 0.6 });

      images.forEach((img, i) => {
        const row = Math.floor(i / 2);
        const onLeft = i % 2 === 0;
        const z = -(SPACING * (row + 1));
        const h = 1.9;
        const w = Math.min(h * img.ratio, 3.2);
        const tex = loader.load(img.src);
        tex.colorSpace = THREE.SRGBColorSpace;
        const art = new THREE.Mesh(new THREE.PlaneGeometry(w, h), new THREE.MeshBasicMaterial({ map: tex }));
        const frame = new THREE.Mesh(new THREE.PlaneGeometry(w + 0.14, h + 0.14), frameMat);
        const x = onLeft ? -HALL_W / 2 + 0.06 : HALL_W / 2 - 0.06;
        const ry = onLeft ? Math.PI / 2 : -Math.PI / 2;
        [art, frame].forEach((m) => { m.position.set(x, EYE, z); m.rotation.y = ry; });
        art.position.x += onLeft ? 0.02 : -0.02;
        scene.add(frame, art);
        const spot = new THREE.PointLight('#fff7e8', 6, 6, 2);
        spot.position.set(onLeft ? x + 1.2 : x - 1.2, WALL_H - 0.4, z);
        scene.add(spot);
      });

      // ---- Controls ----
      const minX = -HALL_W / 2 + 0.7, maxX = HALL_W / 2 - 0.7;
      const minZ = -HALL_LEN + 0.7, maxZ = SPACING - 0.7;
      const clamp = () => {
        camera.position.x = Math.min(maxX, Math.max(minX, camera.position.x));
        camera.position.z = Math.min(maxZ, Math.max(minZ, camera.position.z));
        camera.position.y = EYE;
      };

      let orbit: OrbitControls | null = null;
      let lock: PointerLockControls | null = null;
      const keys: Record<string, boolean> = {};

      if (isTouch) {
        orbit = new OrbitControls(camera, renderer.domElement);
        orbit.target.set(0, EYE, midZ);
        orbit.enableDamping = true;
        orbit.minDistance = 1; orbit.maxDistance = HALL_LEN;
        orbit.maxPolarAngle = Math.PI * 0.52;
        camera.position.set(0, EYE + 0.3, SPACING - 0.5);
      } else {
        crosshair.style.display = 'block';
        lock = new PointerLockControls(camera, document.body);
        document.querySelector('#start .enter')!.addEventListener('click', () => lock!.lock());
        lock.addEventListener('lock', () => fadeOut(startEl));
        lock.addEventListener('unlock', () => { startEl.hidden = false; startEl.style.opacity = '1'; });
        addEventListener('keydown', (e) => (keys[e.code] = true));
        addEventListener('keyup', (e) => (keys[e.code] = false));
      }

      // ---- Loading UX: reveal when ready, but NEVER hang ----
      let revealed = false;
      const reveal = () => {
        if (revealed) return;
        revealed = true;
        barFill.style.width = '100%';
        fadeOut(loadingEl);
        if (isTouch) {
          touchHint.hidden = false;
          setTimeout(() => fadeOut(touchHint), 2600);
        } else {
          startEl.hidden = false;
        }
      };
      manager.onProgress = (_u, loaded, total) => {
        const pct = Math.round((loaded / total) * 100);
        loadingText.textContent = `Loading ${pct}%`;
        barFill.style.width = pct + '%';
      };
      manager.onLoad = reveal;
      // A failed texture must not block the gallery (this was the Safari hang).
      manager.onError = (url) => console.warn('Image failed to load:', url);
      // Safety net: reveal after 6s no matter what; late textures just pop in.
      setTimeout(reveal, 6000);
      if (images.length === 0) reveal();

      // ---- Loop (room renders immediately behind the loader) ----
      const clock = new THREE.Clock();
      function animate() {
        requestAnimationFrame(animate);
        const dt = Math.min(clock.getDelta(), 0.1);
        if (lock && lock.isLocked) {
          const run = keys['ShiftLeft'] || keys['ShiftRight'] ? 2 : 1;
          const speed = 3.4 * run * dt;
          const fwd = (keys['KeyW'] || keys['ArrowUp'] ? 1 : 0) - (keys['KeyS'] || keys['ArrowDown'] ? 1 : 0);
          const side = (keys['KeyD'] || keys['ArrowRight'] ? 1 : 0) - (keys['KeyA'] || keys['ArrowLeft'] ? 1 : 0);
          if (fwd) lock.moveForward(fwd * speed);
          if (side) lock.moveRight(side * speed);
          clamp();
        }
        orbit?.update();
        renderer.render(scene, camera);
      }
      animate();

      addEventListener('resize', () => {
        camera.aspect = innerWidth / innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(innerWidth, innerHeight);
      });
    </script>
  </body>
</html>
