---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import sharp from 'sharp';
import path from 'node:path';

// Real photos → optimized webp + a mood palette sampled from each photo's
// dominant colour, fed into the vendored Codrops depth-gallery engine.
const mods = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portfolio/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const keys = Object.keys(mods).sort();

type RGB = { r: number; g: number; b: number };
const xs = [-0.85, 0.7, -0.6, 0.9, -0.75, 0.55, -0.9, 0.65, -0.5, 0.8];
const clamp = (v: number) => Math.max(0, Math.min(255, Math.round(v)));
const hex = (c: RGB) => '#' + [c.r, c.g, c.b].map((v) => clamp(v).toString(16).padStart(2, '0')).join('');
const mix = (a: RGB, b: RGB, t: number): RGB => ({ r: a.r + (b.r - a.r) * t, g: a.g + (b.g - a.g) * t, b: a.b + (b.b - a.b) * t });
const lum = (c: RGB) => (0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b) / 255;
const DARK: RGB = { r: 18, g: 18, b: 20 };
const WHITE: RGB = { r: 255, g: 255, b: 255 };

const galleryData = await Promise.all(
  keys.map(async (key, i) => {
    const meta = mods[key].default;
    const img = await getImage({ src: meta, format: 'webp', width: 1200 });
    let d: RGB = { r: 120, g: 120, b: 130 };
    try {
      const fsPath = path.join(process.cwd(), 'src/assets/portfolio', path.basename(key));
      d = (await sharp(fsPath).stats()).dominant;
    } catch {
      /* fall back to neutral */
    }
    const bg = mix(d, DARK, 0.62);
    return {
      textureSrc: img.src,
      position: { x: xs[i % xs.length], y: 0 },
      fallbackColor: hex(d),
      accentColor: hex(d),
      backgroundColor: hex(bg),
      blob1Color: hex(d),
      blob2Color: hex(mix(d, WHITE, 0.45)),
      label: { word: '', pms: '', color: lum(bg) > 0.5 ? '#1a1a1a' : '#f4f4f4' },
    };
  }),
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>3D Gallery (experiment) · Ben Tims Media</title>
    <style is:global>
      html, body { margin: 0; height: 100%; background: #111114; overflow: hidden; }
      #back {
        position: fixed; top: max(14px, env(safe-area-inset-top)); left: 14px; z-index: 50;
        display: inline-flex; align-items: center; height: 40px; padding: 0 14px; gap: 6px;
        font: 500 13px ui-sans-serif, -apple-system, system-ui, sans-serif; color: #fff;
        text-decoration: none; border-radius: 999px; background: rgba(0,0,0,.4);
        border: 1px solid rgba(255,255,255,.18); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
      }
      #gl-loading {
        position: fixed; inset: 0; z-index: 60; display: grid; place-items: center;
        background: #111114; color: rgba(255,255,255,.8); transition: opacity .5s ease;
        font: 14px ui-sans-serif, -apple-system, system-ui, sans-serif;
      }
      #gl-loading .spin {
        width: 30px; height: 30px; margin: 0 auto 14px; border-radius: 50%;
        border: 2px solid rgba(255,255,255,.18); border-top-color: #fff; animation: glspin .8s linear infinite;
      }
      @keyframes glspin { to { transform: rotate(360deg); } }
      #gl-hint {
        position: fixed; left: 50%; transform: translateX(-50%); z-index: 45;
        bottom: max(20px, calc(env(safe-area-inset-bottom) + 14px));
        font: 12.5px ui-sans-serif, system-ui, sans-serif; color: rgba(255,255,255,.7);
        padding: 8px 15px; border-radius: 999px; background: rgba(0,0,0,.4);
        -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
        transition: opacity .6s ease; pointer-events: none; white-space: nowrap;
      }
    </style>
  </head>
  <body>
    <a id="back" href="/">← Back</a>
    <div class="content"><canvas class="webgl"></canvas></div>
    <div id="gl-hint">Scroll or swipe to move through the gallery</div>
    <div id="gl-loading"><div><div class="spin"></div><p>Loading gallery…</p></div></div>

    <script is:inline set:html={`window.__GALLERY_DATA__ = ${JSON.stringify(galleryData)};`}></script>

    <script>
      import '@/css/base.css';
      import '@/css/canvas.css';
      import { Engine } from '@/Experience/Engine';

      const canvas = document.querySelector('.webgl');
      const loading = document.getElementById('gl-loading');
      const hint = document.getElementById('gl-hint');
      const done = () => {
        loading?.style.setProperty('opacity', '0');
        setTimeout(() => loading?.remove(), 520);
        setTimeout(() => hint?.style.setProperty('opacity', '0'), 3600);
      };

      if (canvas instanceof HTMLCanvasElement) {
        const engine = new Engine(canvas);
        engine.init().then(done).catch((err) => {
          console.error('Gallery init failed', err);
          done();
        });
      }
    </script>
  </body>
</html>
