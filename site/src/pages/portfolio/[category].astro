---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import { categories, collectionsForCategory } from '../../lib/gallery';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const collections = collectionsForCategory(category.slug);

// Flat photo list (newest collection first) for the lightbox; precompute the
// starting lightbox index of each collection so grid buttons map correctly.
let running = 0;
const blocks = collections.map((col) => {
  const start = running;
  running += col.photos.length;
  return { col, start };
});
const flat = collections.flatMap((c) => c.photos);
const full = await Promise.all(flat.map((p) => getImage({ src: p.meta, format: 'webp', width: 1600 })));
const fullUrls = full.map((f) => f.src);
const alts = flat.map((p) => p.alt);

const fmtDate = (d: string) => {
  const t = Date.parse(d);
  return Number.isNaN(t) ? '' : new Date(t).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
};
---
<BaseLayout
  title={`${category.name} · Portfolio`}
  description={`${category.name} photography by ${SITE.name}.`}
>
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20">
    <a href="/portfolio/" class="text-sm text-stone-500 transition hover:text-stone-900">← Portfolio</a>
    <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2.25rem,7vw,4rem)]">{category.name}</h1>

    {
      collections.length === 0 ? (
        <p class="mt-6 text-stone-600">No photos in this category yet.</p>
      ) : (
        blocks.map(({ col, start }) => (
          <div class="mt-12 first:mt-10">
            <div class="flex items-baseline justify-between border-b border-stone-200 pb-2">
              <h2 class="font-serif text-xl sm:text-2xl">{col.name}</h2>
              {fmtDate(col.date) && <span class="text-sm text-stone-500">{fmtDate(col.date)}</span>}
            </div>
            <div class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3">
              {col.photos.map((p, j) => (
                <button
                  type="button"
                  data-i={start + j}
                  aria-label={`View ${p.alt || 'image'} larger`}
                  class="group relative block aspect-[4/5] overflow-hidden bg-stone-100"
                >
                  <Image
                    src={p.meta}
                    alt={p.alt}
                    widths={[400, 800]}
                    sizes="(max-width: 640px) 50vw, 33vw"
                    format="webp"
                    quality={74}
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  />
                </button>
              ))}
            </div>
          </div>
        ))
      )
    }
  </section>

  <div
    id="lightbox"
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="Image viewer"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 p-4"
  >
    <button data-close aria-label="Close" class="absolute right-3 top-3 inline-flex h-11 w-11 items-center justify-center rounded-full text-2xl text-white/90 hover:bg-white/10">×</button>
    <button data-prev aria-label="Previous" class="absolute left-2 inline-flex h-12 w-12 items-center justify-center rounded-full text-3xl text-white/90 hover:bg-white/10 sm:left-5">‹</button>
    <img id="lb-img" alt="" class="max-h-[88vh] max-w-[92vw] object-contain" />
    <button data-next aria-label="Next" class="absolute right-2 inline-flex h-12 w-12 items-center justify-center rounded-full text-3xl text-white/90 hover:bg-white/10 sm:right-5">›</button>
  </div>

  <script type="application/json" id="gallery-full" set:html={JSON.stringify(fullUrls)}></script>
  <script type="application/json" id="gallery-alts" set:html={JSON.stringify(alts)}></script>

  <script>
    const fulls: string[] = JSON.parse(document.getElementById('gallery-full')?.textContent || '[]');
    const alts: string[] = JSON.parse(document.getElementById('gallery-alts')?.textContent || '[]');
    const lb = document.getElementById('lightbox') as HTMLElement;
    const lbImg = document.getElementById('lb-img') as HTMLImageElement;
    let idx = 0;
    const show = (i: number) => {
      idx = (i + fulls.length) % fulls.length;
      lbImg.src = fulls[idx];
      lbImg.alt = alts[idx] || '';
    };
    const open = (i: number) => { show(i); lb.hidden = false; document.body.style.overflow = 'hidden'; };
    const close = () => { lb.hidden = true; lbImg.removeAttribute('src'); document.body.style.overflow = ''; };
    document.querySelectorAll<HTMLButtonElement>('[data-i]').forEach((btn) =>
      btn.addEventListener('click', () => open(Number(btn.dataset.i))),
    );
    lb.querySelector('[data-close]')!.addEventListener('click', close);
    lb.querySelector('[data-prev]')!.addEventListener('click', () => show(idx - 1));
    lb.querySelector('[data-next]')!.addEventListener('click', () => show(idx + 1));
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(idx - 1);
      else if (e.key === 'ArrowRight') show(idx + 1);
    });
    let sx = 0;
    lb.addEventListener('touchstart', (e) => (sx = e.changedTouches[0].clientX), { passive: true });
    lb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
    }, { passive: true });
  </script>
</BaseLayout>
