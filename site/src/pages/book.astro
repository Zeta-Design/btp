---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const CALENDLY: Record<string, string> = {
  'real-estate':     'https://calendly.com/benjammintims/30min',
  'vacation-rental': 'https://calendly.com/benjammintims/vacation-rental-photography',
};

const params      = Astro.url.searchParams;
const service     = params.get('service') ?? '';
const isScheduled = !!CALENDLY[service];

// Pre-filled from Calendly redirect
const prefillName  = params.get('invitee_full_name') ?? '';
const prefillEmail = params.get('invitee_email') ?? '';
const eventStart   = params.get('event_start_time') ?? '';

// UTM fallback: Calendly passes these through from the pricing modal click
const utmPrice = params.get('utm_content') ?? '';
const utmTier  = params.get('utm_term')    ?? '';

let shootDateFormatted = '';
if (eventStart) {
  try {
    shootDateFormatted = new Date(eventStart).toLocaleString('en-US', {
      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
      hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
    });
  } catch {}
}

const serviceLabel = service === 'real-estate' ? 'Real Estate Photography' : 'Vacation Rental Photography';
---
<BaseLayout
  title="Book a Shoot"
  description={`Reserve your shoot date with ${SITE.name}. A $150 deposit holds your spot — balance due after your session.`}
>
  <section class="mx-auto max-w-2xl px-5 py-14 sm:px-6 sm:py-20">

    {!isScheduled ? (
      /* ── Step 1: Choose service ── */
      <>
        <p class="text-xs uppercase tracking-[0.25em] text-stone-400">Book a shoot</p>
        <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2.25rem,6vw,3.5rem)]">
          Choose your service
        </h1>
        <p class="mt-4 text-pretty text-stone-600">
          Select the type of shoot below to check availability and pick a date. You'll pay the $150 deposit on the next step.
        </p>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          <a
            href={CALENDLY['real-estate']}
            class="group flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-7 transition hover:border-stone-400 hover:shadow-sm"
          >
            <div>
              <p class="text-xs font-medium uppercase tracking-widest text-stone-400">2 hr 30 min</p>
              <p class="mt-3 font-serif text-2xl text-stone-900">Real Estate Photography</p>
              <p class="mt-2 text-sm text-stone-500">MLS &amp; for-sale listings, priced by square footage</p>
            </div>
            <p class="mt-6 text-sm font-medium text-stone-700 group-hover:text-stone-900">
              Schedule a date →
            </p>
          </a>

          <a
            href={CALENDLY['vacation-rental']}
            class="group flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-7 transition hover:border-stone-400 hover:shadow-sm"
          >
            <div>
              <p class="text-xs font-medium uppercase tracking-widest text-stone-400">3 hr 30 min</p>
              <p class="mt-3 font-serif text-2xl text-stone-900">Vacation Rental Photography</p>
              <p class="mt-2 text-sm text-stone-500">Airbnb, VRBO &amp; short-term rentals, priced by bedrooms</p>
            </div>
            <p class="mt-6 text-sm font-medium text-stone-700 group-hover:text-stone-900">
              Schedule a date →
            </p>
          </a>
        </div>

        <p class="mt-6 text-center text-xs text-stone-400">
          Not sure which fits? <a href="/pricing/" class="underline underline-offset-2 hover:text-stone-700">View pricing</a>
        </p>
      </>
    ) : (
      /* ── Step 2: Pay deposit ── */
      <>
        <p class="text-xs uppercase tracking-[0.25em] text-stone-400">Step 2 of 2 — Pay deposit</p>
        <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2.25rem,6vw,3.5rem)]">
          Confirm your booking
        </h1>
        <p class="mt-4 text-pretty text-stone-600">
          Your shoot date is scheduled. Pay the <strong class="font-medium text-stone-800">$150 deposit</strong> below to lock it in — balance due after your session.
        </p>

        <div class="mt-6 rounded-xl border border-stone-200 bg-stone-50 px-5 py-4">
          <p class="text-xs font-medium uppercase tracking-widest text-stone-400">Scheduled shoot</p>
          <p id="btp-tier-label" class="mt-1 font-medium text-stone-900">{utmTier || serviceLabel}</p>
          {shootDateFormatted && <p class="text-sm text-stone-600">{shootDateFormatted}</p>}
          <p id="btp-price-label" class={`mt-0.5 text-sm text-stone-500${utmPrice ? '' : ' hidden'}`}>{utmPrice ? `Package: ${utmPrice}` : ''}</p>
        </div>

        <form method="POST" action="/api/checkout" class="mt-8 space-y-6">
          <input type="hidden" name="service"   id="btp-service-input" value={serviceLabel} />
          <input type="hidden" name="shootDate" value={eventStart || 'To be confirmed'} />
          <input type="hidden" name="tier"      id="btp-tier-input" value={utmTier} />
          <input type="hidden" name="price"     id="btp-price-input" value={utmPrice} />

          <!-- Name + Email -->
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-medium text-stone-700">Full name</label>
              <input
                type="text" id="name" name="name" required autocomplete="name"
                value={prefillName}
                class="mt-1.5 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
                placeholder="Jane Smith"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-stone-700">Email</label>
              <input
                type="email" id="email" name="email" required autocomplete="email"
                value={prefillEmail}
                class="mt-1.5 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
                placeholder="jane@example.com"
              />
            </div>
          </div>

          <!-- Phone -->
          <div>
            <label for="phone" class="block text-sm font-medium text-stone-700">Phone <span class="text-red-500">*</span></label>
            <input
              type="tel" id="phone" name="phone" required autocomplete="tel"
              class="mt-1.5 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
              placeholder="(512) 000-0000"
            />
          </div>

          <!-- Property address -->
          <div class="space-y-4">
            <p class="text-sm font-medium text-stone-700">Property address</p>
            <div>
              <label for="address" class="block text-xs text-stone-500">Street address</label>
              <input
                type="text" id="address" name="address" required autocomplete="address-line1"
                class="mt-1 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
                placeholder="123 Main St"
              />
            </div>
            <div>
              <label for="address2" class="block text-xs text-stone-500">Address line 2 <span class="text-stone-400">(optional)</span></label>
              <input
                type="text" id="address2" name="address2" autocomplete="address-line2"
                class="mt-1 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
                placeholder="Unit, suite, apt, etc."
              />
            </div>
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
              <div class="col-span-2 sm:col-span-1">
                <label for="city" class="block text-xs text-stone-500">City</label>
                <input
                  type="text" id="city" name="city" required autocomplete="address-level2"
                  class="mt-1 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
                  placeholder="Austin"
                />
              </div>
              <div>
                <label for="state" class="block text-xs text-stone-500">State</label>
                <input
                  type="text" id="state" name="state" required maxlength="2" autocomplete="address-level1"
                  class="mt-1 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500 uppercase"
                  placeholder="TX"
                />
              </div>
              <div>
                <label for="zip" class="block text-xs text-stone-500">ZIP code</label>
                <input
                  type="text" id="zip" name="zip" required autocomplete="postal-code" inputmode="numeric"
                  class="mt-1 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
                  placeholder="78701"
                />
              </div>
            </div>
          </div>

          <!-- Add-ons -->
          <div class="space-y-3">
            <p class="text-sm font-medium text-stone-700">Add-ons <span class="font-normal text-stone-400">(optional — same day as your shoot)</span></p>
            <label class="flex cursor-pointer items-start gap-4 rounded-xl border border-stone-200 bg-white p-4 transition hover:border-stone-400 has-[:checked]:border-stone-900 has-[:checked]:bg-stone-50">
              <input type="checkbox" name="addon_video" id="btp-addon-video" value="1" class="mt-0.5 h-4 w-4 accent-stone-900" />
              <div class="flex-1">
                <p class="text-sm font-medium text-stone-900">Walkthrough Video</p>
                <p class="mt-0.5 text-xs text-stone-500">Gimbal walkthrough + 30–60 sec vertical social reel</p>
              </div>
              <p class="shrink-0 text-sm font-medium text-stone-900">+$200</p>
            </label>
            <label class="flex cursor-pointer items-start gap-4 rounded-xl border border-stone-200 bg-white p-4 transition hover:border-stone-400 has-[:checked]:border-stone-900 has-[:checked]:bg-stone-50">
              <input type="checkbox" name="addon_twilight" id="btp-addon-twilight" value="1" class="mt-0.5 h-4 w-4 accent-stone-900" />
              <div class="flex-1">
                <p class="text-sm font-medium text-stone-900">Twilight Session</p>
                <p class="mt-0.5 text-xs text-stone-500">6–8 dusk/twilight exterior photos, same day as main shoot</p>
              </div>
              <p class="shrink-0 text-sm font-medium text-stone-900">+$150</p>
            </label>
          </div>

          <!-- Payment option selector -->
          <input type="hidden" name="paymentOption" id="btp-payment-option" value="deposit" />

          <div class="space-y-3">
            <p class="text-sm font-medium text-stone-700">Payment option</p>
            <div class="grid gap-3 sm:grid-cols-2" id="btp-payment-cards">

              <!-- Deposit option (default selected) -->
              <button
                type="button"
                id="btp-opt-deposit"
                class="btp-pay-opt rounded-xl border-2 border-stone-900 bg-white p-4 text-left transition"
                data-value="deposit"
              >
                <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">Deposit</p>
                <p id="btp-deposit-price" class="mt-1 text-xl font-light text-stone-900">$150 <span class="text-sm font-normal text-stone-500">now</span></p>
                <p class="mt-1 text-xs text-stone-500">Balance due after your shoot</p>
              </button>

              <!-- Pay in full option -->
              <button
                type="button"
                id="btp-opt-full"
                class="btp-pay-opt rounded-xl border-2 border-stone-200 bg-white p-4 text-left transition hover:border-stone-400"
                data-value="full"
              >
                <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">Pay in full</p>
                <p id="btp-full-price" class="mt-1 text-xl font-light text-stone-900">{utmPrice ? `${utmPrice} now` : '—'}</p>
                <p class="mt-1 text-xs text-stone-500">Everything covered upfront</p>
              </button>
            </div>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              id="btp-submit-btn"
              class="w-full rounded-lg bg-stone-900 px-6 py-3.5 text-sm font-medium tracking-wide text-white transition hover:bg-stone-700 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:ring-offset-2"
            >
              Pay $150 deposit →
            </button>
            <p id="btp-submit-note" class="mt-3 text-center text-xs text-stone-400">
              Secure checkout via Stripe · Balance due after your shoot
            </p>
          </div>
        </form>
      </>
    )}

  </section>
<script>
  const ADDON_VIDEO_PRICE    = 200;
  const ADDON_TWILIGHT_PRICE = 150;

  const addonVideo     = document.getElementById('btp-addon-video')     as HTMLInputElement | null;
  const addonTwilight  = document.getElementById('btp-addon-twilight')  as HTMLInputElement | null;
  const depositPriceEl = document.getElementById('btp-deposit-price');
  const fullPriceEl    = document.getElementById('btp-full-price');
  const optDeposit     = document.getElementById('btp-opt-deposit')     as HTMLButtonElement | null;
  const optFull        = document.getElementById('btp-opt-full')        as HTMLButtonElement | null;
  const paymentInput   = document.getElementById('btp-payment-option')  as HTMLInputElement | null;
  const submitBtn      = document.getElementById('btp-submit-btn')      as HTMLButtonElement | null;
  const submitNote     = document.getElementById('btp-submit-note')     as HTMLParagraphElement | null;

  // Initialize from server-rendered UTM value (pre-populated in the hidden input)
  const priceInputEl = document.getElementById('btp-price-input') as HTMLInputElement | null;
  let basePriceNum = priceInputEl?.value
    ? parseFloat(priceInputEl.value.replace(/[^0-9.]/g, ''))
    : 0;

  function getAddonTotal(): number {
    return (addonVideo?.checked ? ADDON_VIDEO_PRICE : 0) +
           (addonTwilight?.checked ? ADDON_TWILIGHT_PRICE : 0);
  }

  function updateDisplay() {
    const addonAmt  = getAddonTotal();
    const fullTotal = basePriceNum > 0 ? basePriceNum + addonAmt : 0;
    const isDeposit = (paymentInput?.value ?? 'deposit') === 'deposit';

    // Deposit is always $150 — add-ons are billed with the remaining balance after the shoot
    if (depositPriceEl) {
      depositPriceEl.innerHTML = `$150 <span style="font-size:0.875rem;font-weight:400;color:#78716c;">now</span>`;
    }
    if (fullPriceEl) {
      fullPriceEl.innerHTML = fullTotal > 0
        ? `$${fullTotal} <span style="font-size:0.875rem;font-weight:400;color:#78716c;">now</span>`
        : '—';
    }
    if (submitBtn) {
      submitBtn.textContent = isDeposit
        ? 'Pay $150 deposit →'
        : fullTotal > 0 ? `Pay $${fullTotal} in full →` : submitBtn.textContent;
    }
    if (submitNote) {
      if (isDeposit) {
        submitNote.textContent = addonAmt > 0
          ? 'Secure checkout via Stripe · Add-ons included in final balance'
          : 'Secure checkout via Stripe · Balance due after your shoot';
      } else {
        submitNote.textContent = 'Secure checkout via Stripe · No balance due after your shoot';
      }
    }
  }

  function selectOption(value: string) {
    if (!paymentInput || !optDeposit || !optFull) return;
    paymentInput.value = value;
    if (value === 'deposit') {
      optDeposit.classList.add('border-stone-900');
      optDeposit.classList.remove('border-stone-200');
      optFull.classList.remove('border-stone-900');
      optFull.classList.add('border-stone-200');
    } else {
      optFull.classList.add('border-stone-900');
      optFull.classList.remove('border-stone-200');
      optDeposit.classList.remove('border-stone-900');
      optDeposit.classList.add('border-stone-200');
    }
    updateDisplay();
  }

  optDeposit?.addEventListener('click', () => selectOption('deposit'));
  optFull?.addEventListener('click', () => selectOption('full'));
  addonVideo?.addEventListener('change', updateDisplay);
  addonTwilight?.addEventListener('change', updateDisplay);

  // Populate from sessionStorage (set by pricing page before Calendly redirect)
  const raw = sessionStorage.getItem('btpBooking');
  if (raw) {
    try {
      const { service, tier, price } = JSON.parse(raw);
      const tierLabel  = document.getElementById('btp-tier-label');
      const priceLabel = document.getElementById('btp-price-label');
      const tierInput  = document.getElementById('btp-tier-input')  as HTMLInputElement | null;
      const svcInput   = document.getElementById('btp-service-input') as HTMLInputElement | null;
      const priceInput = document.getElementById('btp-price-input') as HTMLInputElement | null;

      if (tierLabel && tier)   tierLabel.textContent = tier;
      if (tierInput && tier)   tierInput.value = tier;
      if (priceInput && price) priceInput.value = price;
      if (svcInput && service) svcInput.value = service === 'real-estate' ? 'Real Estate Photography' : 'Vacation Rental Photography';
      if (priceLabel && price) {
        priceLabel.textContent = `Package: ${price}`;
        priceLabel.classList.remove('hidden');
      }
      sessionStorage.removeItem('btpBooking');
      if (price) basePriceNum = parseFloat(price.replace(/[^0-9.]/g, ''));
    } catch {}
  }

  updateDisplay();
</script>
</BaseLayout>
