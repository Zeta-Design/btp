---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---
<BaseLayout
  title="Book a Shoot"
  description={`Reserve your shoot date with ${SITE.name}. A $150 deposit holds your spot — balance due after your session.`}
>
  <section class="mx-auto max-w-2xl px-5 py-14 sm:px-6 sm:py-20">
    <p class="text-xs uppercase tracking-[0.25em] text-stone-400">Book a shoot</p>
    <h1 class="mt-3 font-serif leading-[1.05] text-[clamp(2.25rem,6vw,3.5rem)]">
      Reserve your date
    </h1>
    <p class="mt-4 text-pretty text-stone-600">
      Fill in your details below and you'll be taken to a secure checkout to pay the
      <strong class="font-medium text-stone-800">$150 deposit</strong>.
      The remaining balance is due after your shoot.
    </p>

    <form
      method="POST"
      action="/api/checkout"
      class="mt-10 space-y-6"
    >
      <!-- Name + Email -->
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="name" class="block text-sm font-medium text-stone-700">Full name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            class="mt-1.5 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
            placeholder="Jane Smith"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-stone-700">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="mt-1.5 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
            placeholder="jane@example.com"
          />
        </div>
      </div>

      <!-- Phone -->
      <div>
        <label for="phone" class="block text-sm font-medium text-stone-700">
          Phone <span class="text-stone-400">(optional)</span>
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          autocomplete="tel"
          class="mt-1.5 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
          placeholder="(512) 000-0000"
        />
      </div>

      <!-- Service type -->
      <div>
        <label for="service" class="block text-sm font-medium text-stone-700">Service</label>
        <select
          id="service"
          name="service"
          required
          class="mt-1.5 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
        >
          <option value="" disabled selected>Select a service…</option>
          <optgroup label="Real Estate">
            <option value="Real Estate – Up to 1,500 sq ft ($185)">Up to 1,500 sq ft — $185</option>
            <option value="Real Estate – 1,500–2,500 sq ft ($225)">1,500–2,500 sq ft — $225</option>
            <option value="Real Estate – 2,500–4,000 sq ft ($295)">2,500–4,000 sq ft — $295</option>
            <option value="Real Estate – 4,000–5,500 sq ft ($375)">4,000–5,500 sq ft — $375</option>
            <option value="Real Estate – 5,500–8,000 sq ft ($475)">5,500–8,000 sq ft — $475</option>
            <option value="Real Estate – 8,000+ sq ft ($595)">8,000+ sq ft — $595</option>
          </optgroup>
          <optgroup label="Vacation Rental &amp; STR">
            <option value="STR – 1–2 Bedrooms ($265)">1–2 Bedrooms — $265</option>
            <option value="STR – 3–4 Bedrooms ($335)">3–4 Bedrooms — $335</option>
            <option value="STR – 4–5 Bedrooms ($425)">4–5 Bedrooms — $425</option>
            <option value="STR – 6+ Bedrooms ($550)">6+ Bedrooms — $550</option>
            <option value="STR – 6+ Bedrooms Premium ($650)">6+ Bedrooms Premium — $650</option>
          </optgroup>
        </select>
      </div>

      <!-- Shoot date -->
      <div>
        <label for="shootDate" class="block text-sm font-medium text-stone-700">Preferred shoot date</label>
        <input
          type="date"
          id="shootDate"
          name="shootDate"
          required
          class="mt-1.5 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
        />
      </div>

      <!-- Property address -->
      <div>
        <label for="address" class="block text-sm font-medium text-stone-700">Property address</label>
        <input
          type="text"
          id="address"
          name="address"
          required
          autocomplete="street-address"
          class="mt-1.5 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-1 focus:ring-stone-500"
          placeholder="123 Main St, Austin, TX 78701"
        />
      </div>

      <div class="pt-2">
        <button
          type="submit"
          class="w-full rounded-lg bg-stone-900 px-6 py-3.5 text-sm font-medium tracking-wide text-white transition hover:bg-stone-700 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:ring-offset-2"
        >
          Pay $150 deposit →
        </button>
        <p class="mt-3 text-center text-xs text-stone-400">
          Secure checkout via Stripe · Balance due after your shoot
        </p>
      </div>
    </form>
  </section>
</BaseLayout>
