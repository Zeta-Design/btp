---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found"
  description="The page you're looking for doesn't exist or may have moved."
>
  <section
    class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-6 py-24 text-center"
  >
    <p class="text-sm uppercase tracking-[0.25em] text-stone-500">404</p>
    <h1 class="mt-4 font-serif text-4xl sm:text-5xl">This page wandered off.</h1>
    <p class="mt-4 text-stone-600">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="rounded-full bg-stone-900 px-7 py-3 text-sm text-stone-50 transition hover:bg-stone-700"
      >
        Back home
      </a>
      <a
        href="/portfolio/"
        class="rounded-full border border-stone-300 px-7 py-3 text-sm text-stone-700 transition hover:border-stone-500"
      >
        View portfolio
      </a>
      <a
        href="/contact/"
        class="rounded-full border border-stone-300 px-7 py-3 text-sm text-stone-700 transition hover:border-stone-500"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>
