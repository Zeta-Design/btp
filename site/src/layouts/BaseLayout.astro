---
import '@fontsource-variable/inter';
import '@fontsource-variable/playfair-display';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}
const { title, description, image, type, jsonLd } = Astro.props;
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={fullTitle} description={description} image={image} type={type} />
    {jsonLd && <JsonLd schema={jsonLd} />}
  </head>
  <body class="min-h-dvh bg-stone-50 font-sans text-stone-900 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-stone-900 focus:px-5 focus:py-3 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
