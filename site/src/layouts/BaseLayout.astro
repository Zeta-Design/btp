---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}
const { title, description, image, type, jsonLd } = Astro.props;
// Brand name as suffix, except on the home page where title === brand name.
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={fullTitle} description={description} image={image} type={type} />
    {jsonLd && <JsonLd schema={jsonLd} />}
  </head>
  <body class="min-h-screen bg-stone-50 font-sans text-stone-900">
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
