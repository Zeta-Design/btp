---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config/site';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate } = post.data;

// BlogPosting structured data → eligible for Google rich results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};

const dateLabel = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout title={title} description={description} type="article" jsonLd={jsonLd}>
  <article class="mx-auto max-w-2xl px-5 py-14 sm:px-6 sm:py-20">
    <a href="/blog/" class="inline-flex min-h-[44px] items-center text-sm text-stone-500 transition hover:text-stone-900">← Blog</a>
    <header class="mt-4">
      <h1 class="font-serif leading-[1.05] text-[clamp(2rem,5vw,3rem)]">{title}</h1>
      <p class="mt-3 text-sm text-stone-500">
        <time datetime={pubDate.toISOString()}>{dateLabel}</time>
        {updatedDate && <span> · updated {updatedDate.toLocaleDateString('en-US')}</span>}
      </p>
    </header>
    <div class="prose-body mt-8 text-lg leading-relaxed text-stone-700">
      <slot />
    </div>
  </article>
</BaseLayout>
